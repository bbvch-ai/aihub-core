[build-system]
requires = ["poetry-core"]
build-backend = "poetry.core.masonry.api"

[tool.poetry]
name = "agents"
version = "1.0.0"
description = "AI Agent"
authors = ["AI-Hub Developer <developer@ai-hub.bbv.ch>"]
readme = "README.md"

[tool.poetry.dependencies]
python = ">=3.13,<3.14"
aihub-lib = { git = "https://github.com/bbvch-ai/aihub-core.git", subdirectory = "aihub_lib" }
aihub-agent = { git = "https://github.com/bbvch-ai/aihub-core.git", subdirectory = "aihub_agent" }

[tool.poetry.group.dev.dependencies]
pytest = "^8.3.3"
pytest-asyncio = "^0.24.0"
pytest-mock = "^3.14.0"
pytest-bdd = "^7.3.0"
mypy = "^1.13.0"
black = "^24.10.0"
ruff = "^0.7.4"

[tool.black]
line-length = 120

[tool.ruff]
select = ["E", "F", "UP", "I"]
line-length = 120

[tool.mypy]
python_version = "3.11"
strict = true