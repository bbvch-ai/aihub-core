# Agent Development Environment - Environment Variables
#
# Copy this file to .env.agent-dev and customize your passwords:
#   cp .env.agent-dev.template .env.agent-dev
#
# Then load it when starting containers:
#   docker-compose -f docker-compose.agent-dev.yml --env-file .env.agent-dev up -d
#
# SECURITY: Add .env.agent-dev to .gitignore to avoid committing passwords!

# ===================================================================
# VS Code Passwords (one per agent)
# ===================================================================

# Agent 1 - Default development agent
AGENT_1_PASSWORD=developer

# Agent 2 - Legal RAG agent (uncomment when adding)
# AGENT_2_PASSWORD=secure-password-legal-123

# Agent 3 - Product inventory agent (uncomment when adding)
# AGENT_3_PASSWORD=secure-password-product-456

# Agent 4 - Customer support agent (uncomment when adding)
# AGENT_4_PASSWORD=secure-password-support-789

# Agent 5 - Custom agent (uncomment when adding)
# AGENT_5_PASSWORD=secure-password-custom-abc

# ===================================================================
# Infrastructure Settings (optional overrides)
# ===================================================================

# Volume root directory (where Docker volumes are stored)
# VOLUME_ROOT=./.docker-volumes

# OpenAI API key (if using OpenAI models)
# OPENAI_API_KEY=sk-...

# Azure OpenAI settings (if using Azure)
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# LiteLLM settings
# LITELLM_API_KEY=...
