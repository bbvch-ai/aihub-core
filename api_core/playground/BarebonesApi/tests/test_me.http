### Test: Get Current User Information
GET http://localhost:8000/api/v1/user/me
Accept: application/json

> {%
client.test("Response status is 200 OK", function() {
  client.assert(response.status === 200, "Expected status code is 200");
});

client.test("Response body contains correct user data", function() {
  const body = response.body;
  client.assert(body.name === "Melanie Musterfrau", "Name should be Melanie Musterfrau");
  client.assert(body.preferred_username === "melanie.musterfrau@bbv.ch", "Preferred username is correct");
  client.assert(body.roles.includes("AllAgents"), "User roles include AllAgents");
});
%}
