### Test: Post Chat Completion with Streaming
POST http://localhost:8000/chat/completions/my_agent_class/my_agent_id/stream
Content-Type: application/json
Accept: text/event-stream

{
  "messages": [
    {
      "role": "user",
      "content": "Hello, how are you?"
    }
  ]
}

> {%
client.test("Status is 200 OK", function() {
  client.assert(response.status === 200, "Expected status code is 200");
});

client.test("Response is SSE", function() {
  const contentType = response.headers.valueOf("content-type");
  client.assert(
    contentType.includes("text/event-stream"),
    "Expected 'text/event-stream' content type, got: " + contentType
  );
});
%}