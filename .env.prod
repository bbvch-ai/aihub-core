# =============================================================================
# AI-Hub Production Environment Configuration
# =============================================================================
# This file contains ONLY the environment variables that must be configured.
# All internal Docker network endpoints are hardcoded in the compose files.
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
LOG_LEVEL='INFO'
ENV='prod'
DOMAIN='REPLACE_WITH_YOUR_DOMAIN'

# Let's Encrypt / Traefik
ACME_EMAIL='admin@your-company.com'
ADMIN_PASSWORD_HASH=''

# -----------------------------------------------------------------------------
# API Keys (External Services) - Configure at least one LLM provider
# -----------------------------------------------------------------------------
GEMINI_API_KEY=''
HUGGINGFACE_API_KEY=''

# Swiss LLM Cloud (required for all non-GPU setups)
# Each service type may use a different cloud provider/endpoint.
# LLM: text generation models (gemma3n, mistral3)
SWISS_LLM_CLOUD_API_BASE_URL='REPLACE_WITH_SWISS_LLM_CLOUD_URL'
SWISS_LLM_CLOUD_API_KEY='REPLACE_WITH_SWISS_LLM_CLOUD_KEY'
# Embedding: vector embedding models (inference-bge-m3)
SWISS_LLM_CLOUD_EMBEDDING_API_BASE_URL='REPLACE_WITH_SWISS_LLM_CLOUD_EMBEDDING_URL'
SWISS_LLM_CLOUD_EMBEDDING_API_KEY='REPLACE_WITH_SWISS_LLM_CLOUD_EMBEDDING_KEY'
# Reranking: reranking models (inference-bge-reranker), Jina AI compatible endpoint
SWISS_LLM_CLOUD_RERANKING_API_BASE_URL='REPLACE_WITH_SWISS_LLM_CLOUD_RERANKING_URL'
SWISS_LLM_CLOUD_RERANKING_API_KEY='REPLACE_WITH_SWISS_LLM_CLOUD_RERANKING_KEY'
# Whisper: audio transcription (whisper-large-v3), OpenAI compatible endpoint
SWISS_LLM_CLOUD_WHISPER_API_BASE_URL='REPLACE_WITH_SWISS_LLM_CLOUD_WHISPER_URL'
SWISS_LLM_CLOUD_WHISPER_API_KEY='REPLACE_WITH_SWISS_LLM_CLOUD_WHISPER_KEY'
# OCR: document OCR model (mineru), OpenAI compatible endpoint
SWISS_LLM_CLOUD_OCR_API_BASE_URL='REPLACE_WITH_SWISS_LLM_CLOUD_OCR_URL'
SWISS_LLM_CLOUD_OCR_API_KEY='REPLACE_WITH_SWISS_LLM_CLOUD_OCR_KEY'

# -----------------------------------------------------------------------------
# Keycloak Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Keycloak Admin Console
KEYCLOAK_ADMIN_USER='admin'
KEYCLOAK_ADMIN_PASSWORD='REPLACE_WITH_RANDOM_STRING'

# Keycloak Client Secrets (for platform OAuth2 clients)
KEYCLOAK_OPENWEBUI_CLIENT_SECRET='REPLACE_WITH_RANDOM_STRING'

# API service account (least-privilege: view-identity-providers only)
KEYCLOAK_API_SERVICE_CLIENT_SECRET='REPLACE_WITH_RANDOM_STRING'
KEYCLOAK_SHOW_KEYCLOAK_LOGIN='true'

# OAuth2 Proxy client secrets (one per protected service for audit/security isolation)
KEYCLOAK_OAUTH2_PROXY_DAGSTER_SECRET='REPLACE_WITH_RANDOM_STRING'
KEYCLOAK_OAUTH2_PROXY_DATALAKE_SECRET='REPLACE_WITH_RANDOM_STRING'
KEYCLOAK_OAUTH2_PROXY_ATTU_SECRET='REPLACE_WITH_RANDOM_STRING'
KEYCLOAK_OAUTH2_PROXY_BACKUP_SECRET='REPLACE_WITH_RANDOM_STRING'
LANGFUSE_KEYCLOAK_CLIENT_SECRET='REPLACE_WITH_RANDOM_STRING'

# Keycloak URLs (auto-configured based on DOMAIN)
KEYCLOAK_URL='https://auth.${DOMAIN}'
KEYCLOAK_REALM='aihub'

# Superuser (interactive Keycloak-seeded admin). Its realm roles grant sysadmin
# access via the normal OAuth2 flow — AIHubSysAdmin is required for sysadmin
# routes, so keep it in SUPERUSER_ROLES_JSON.
SUPERUSER_USERNAME='admin'
SUPERUSER_PASSWORD='REPLACE_WITH_RANDOM_STRING'
SUPERUSER_EMAIL='admin@your-company.com'
SUPERUSER_FIRSTNAME='Admin'
SUPERUSER_LASTNAME='User'
SUPERUSER_ROLES_JSON='["AIHubAdmin", "AIHubSysAdmin"]'
# Superuser static bearer token. Seeded into the bearer_tokens collection at
# API startup, bound to the Keycloak user found by SUPERUSER_EMAIL. Internal
# services use this as their API key and authenticate via TokenAuthHandler.
SUPERUSER_TOKEN='sk-REPLACE_WITH_RANDOM_STRING'

# -----------------------------------------------------------------------------
# Azure Entra ID Identity Provider (for Keycloak federation)
# -----------------------------------------------------------------------------
# These are used by Keycloak to federate authentication to Azure Entra ID.
# Configure these in your Azure App Registration:
#   - Redirect URI: https://auth.${DOMAIN}/realms/aihub/broker/azure-ad/endpoint
KEYCLOAK_AZURE_CLIENT_ID='REPLACE_WITH_AZURE_APP_CLIENT_ID'
KEYCLOAK_AZURE_CLIENT_SECRET='REPLACE_WITH_AZURE_APP_CLIENT_SECRET'
KEYCLOAK_AZURE_TENANT_ID='REPLACE_WITH_AZURE_TENANT_ID'

# -----------------------------------------------------------------------------
# Legacy OAuth2 Settings (kept for backward compatibility)
# -----------------------------------------------------------------------------
# These may be used by services that haven't migrated to Keycloak yet
OAUTH_CLIENT_ID='REPLACE_WITH_YOUR_CLIENT_ID'
OAUTH_CLIENT_SECRET='REPLACE_WITH_YOUR_CLIENT_SECRET'
OAUTH_AUTHORITY_URL='https://login.microsoftonline.com/REPLACE_WITH_YOUR_TENANT_ID'
OAUTH_TENANT_ID='REPLACE_WITH_YOUR_TENANT_ID'

# OAuth Custom Branding (optional)
OAUTH_CUSTOM_SIGN_IN_LOGO=''

# -----------------------------------------------------------------------------
# Authentication & Security (REQUIRED - Generate new secrets!)
# -----------------------------------------------------------------------------
AUTH_OPEN_WEBUI_SIGNING_SECRET='REPLACE_WITH_RANDOM_STRING'
WEBUI_SECRET_KEY='REPLACE_WITH_RANDOM_STRING'

# OpenWebUI Agent Visibility Provisioning
OPENWEBUI_BASE_URL='http://open-webui:8080'
OPENWEBUI_SECRET_KEY='REPLACE_WITH_RANDOM_STRING'
OPENWEBUI_SCIM_TOKEN='REPLACE_WITH_RANDOM_STRING'
OPENWEBUI_WEBHOOK_SECRET='REPLACE_WITH_RANDOM_STRING'
OPENWEBUI_SERVICE_ACCOUNT_ID='REPLACE_WITH_RANDOM_UUID'
OAUTH_ADMIN_ROLES_OPENWEBUI='AIHubSysAdmin'

# -----------------------------------------------------------------------------
# Database Credentials (REQUIRED - Use strong passwords!)
# -----------------------------------------------------------------------------
# PostgreSQL
POSTGRES_USER='admin'
POSTGRES_PASSWORD='REPLACE_WITH_RANDOM_STRING'

# MongoDB (FerretDB)
MONGO_USERNAME='admin'
MONGO_PASSWORD='REPLACE_WITH_RANDOM_STRING'

# NEO4J
NEO4J_URL='bolt://neo4j:7687'
NEO4J_USERNAME='neo4j'
NEO4J_PASSWORD='REPLACE_WITH_RANDOM_STRING'


# S3 Storage (SeaweedFS)
S3_STORAGE_ACCESS_KEY='admin'
S3_STORAGE_SECRET_KEY='REPLACE_WITH_RANDOM_STRING'
# Public endpoint for presigned URLs (used by browsers to download/upload files)
# This should be the externally accessible S3 endpoint via Traefik (e.g., https://s3.yourdomain.com)
# The value is auto-configured in docker-compose as https://s3.${DOMAIN}
# S3_STORAGE_PUBLIC_ENDPOINT="https://s3.${DOMAIN}"

# JWT signing key for internal SeaweedFS component authentication (Master, Volume, Filer, S3)
SEAWEEDFS_TOKEN='REPLACE_WITH_RANDOM_STRING'

# -----------------------------------------------------------------------------
# LiteLLM Configuration (REQUIRED)
# -----------------------------------------------------------------------------
LITELLM_UI_USERNAME='admin'
LITELLM_UI_PASSWORD='REPLACE_WITH_RANDOM_STRING'
LITELLM_MASTER_KEY='REPLACE_WITH_RANDOM_STRING'

# -----------------------------------------------------------------------------
# Local LLM (vLLM) Configuration
# -----------------------------------------------------------------------------
LOCAL_LLM_TOKEN='REPLACE_WITH_RANDOM_STRING'

# -----------------------------------------------------------------------------
# Service Configuration
# -----------------------------------------------------------------------------
JUPYTER_TOKEN='REPLACE_WITH_RANDOM_STRING'

# SearXNG
SEARXNG_SECRET_KEY='REPLACE_WITH_RANDOM_STRING'

# Langfuse Configuration (LLM observability and evaluation)
# Langfuse server internals — generate with: openssl rand -hex 32
LANGFUSE_SALT='REPLACE_WITH_RANDOM_STRING'
LANGFUSE_NEXTAUTH_SECRET='REPLACE_WITH_RANDOM_STRING'
# Must be exactly 64 hex characters — generate with: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY='REPLACE_WITH_64_HEX_CHARS'
# Public URL where Langfuse UI is reachable (used for NextAuth callback)
LANGFUSE_NEXTAUTH_URL='https://langfuse.${DOMAIN}'
# Convention: pk-lf-<random> / sk-lf-<random>
LANGFUSE_PUBLIC_KEY='pk-lf-REPLACE_WITH_LANGFUSE_PUBLIC_KEY'
LANGFUSE_SECRET_KEY='sk-lf-REPLACE_WITH_LANGFUSE_SECRET_KEY'
# Initial admin user created on first startup
LANGFUSE_INIT_USER_EMAIL='admin@your-company.com'
LANGFUSE_INIT_USER_PASSWORD='REPLACE_WITH_RANDOM_STRING'
LANGFUSE_CLICKHOUSE_PASSWORD='REPLACE_WITH_RANDOM_STRING'

# Langfuse Access Control
LANGFUSE_ALLOWED_ORGANIZATION_CREATORS='REPLACE_WITH_ADMIN_EMAIL'

# MinerU Configuration
MINERU_API_TIMEOUT='600'
MINERU_VLM_NAME='text-generation/MinerU2.5-2509-1.2B'
MINERU_FORMULA_ENABLE='true'
MINERU_TABLE_ENABLE='true'
MINERU_API_MAX_CONCURRENT_REQUESTS='10'

# Mem0
MEM0_LLM_NAME='text-generation/gpt-oss-120b'
MEM0_EMBEDDING_MODEL_NAME='embedding/bge-m3'
MEM0_RERANKING_MODEL_NAME='reranker/bge'

# Milvus Configuration (must match your embedding model dimensions)
MILVUS_DIMENSION='1024'
MILVUS_ROOT_PASSWORD='REPLACE_WITH_RANDOM_STRING'

# Etcd Configuration
ETCD_TOKEN='REPLACE_WITH_RANDOM_STRING'

# NATS Configuration (for clients connecting to NATS messaging)
NATS_TOKEN='REPLACE_WITH_RANDOM_STRING'

# Redis/Valkey Configuration
REDIS_TOKEN='REPLACE_WITH_RANDOM_STRING'

# -----------------------------------------------------------------------------
# Multi-Tenant Configuration
# -----------------------------------------------------------------------------

# Startup Tenant Settings
# The tenant the platform seeds on first startup. Once created it is an ordinary
# tenant — no special flags, no special treatment. These values only control the
# first-boot seeding.
AIHUB_STARTUP_TENANT_ID='swiss_ai_hub'
AIHUB_STARTUP_TENANT_NAME='Swiss AI Hub'
AIHUB_STARTUP_TENANT_DESCRIPTION='This tenant was auto-created on startup of the Swiss AI Hub.'
# Access rules for the startup tenant (comma-separated). Use "aihub.admin.>" for unrestricted admin access.
AIHUB_STARTUP_TENANT_ACCESS_RULES='aihub.admin.>'

# User Signup Settings
# Roles assigned to regular users when they sign up (comma-separated)
AIHUB_USER_SIGNUP_REGULAR_USER_ROLES='AIHubUser'
# Roles assigned to the very first user (typically admin). Comma-separated.
AIHUB_USER_SIGNUP_FIRST_ADMIN_USER_ROLES='AIHubAdmin,AIHubUser'

# -----------------------------------------------------------------------------
# AI-Hub Application Settings
# -----------------------------------------------------------------------------
AIHUB_VERSION='latest'
AIHUB_CREATE_DEFAULT_ROLES='True'
AIHUB_CREATE_DEFAULT_BUCKETS='True'
AIHUB_DEFAULT_BUCKET_NAME='defaultknowledge'
AIHUB_SHARED_BUCKET_NAME='sharedknowledge'
AIHUB_DEFAULT_NAMESPACE_NAME='defaultnamespace'
AIHUB_SHARED_NAMESPACE_NAME='sharednamespace'

# Admin Settings
ADMIN_EMAIL='admin@your-company.com'

# OAuth Group Restrictions (Azure AD group names)
OAUTH_ALLOWED_GROUPS_DAGSTER='AIHubSysAdmin'
OAUTH_COOKIE_SECRET_DAGSTER='REPLACE_WITH_RANDOM_STRING'
OAUTH_ALLOWED_GROUPS_SEAWEEDFS='AIHubSysAdmin'
OAUTH_COOKIE_SECRET_SEAWEEDFS='REPLACE_WITH_RANDOM_STRING'
OAUTH_ALLOWED_GROUPS_ATTU='AIHubSysAdmin'
OAUTH_COOKIE_SECRET_ATTU='REPLACE_WITH_RANDOM_STRING'
OAUTH_ALLOWED_GROUPS_BACKUP='AIHubSysAdmin'
OAUTH_COOKIE_SECRET_BACKUP='REPLACE_WITH_RANDOM_STRING'

# Backup Service Configuration
BACKUP_RETENTION_DAYS="30"
BACKUP_MINIMUM_KEEP="7"
BACKUP_S3_BUCKET="backups"
BACKUP_POSTGRES_SUBPROCESS_TIMEOUT_SECONDS="21600"

# Postgres Maintenance — dagster_cleanup_job + postgres_repack_job in the backup
# Dagster instance. See packages/backup/CLAUDE.md.
POSTGRES_PORT="5432"
DAGSTER_DB="dagster"
DAGSTER_DEBUG_LOG_RETENTION_DAYS="7"
DAGSTER_INFO_LOG_RETENTION_DAYS="60"
DAGSTER_WARNING_LOG_RETENTION_DAYS="60"
DAGSTER_UNIMPORTANT_EVENT_RETENTION_DAYS="30"
DAGSTER_CLEANUP_BATCH_LIMIT="1000000"
MAINTENANCE_DISABLED="false"

# -----------------------------------------------------------------------------
# Expert Asking Agent Configuration (Required for expert escalation)
# -----------------------------------------------------------------------------
# Channel type: "teams" or "slack"
EXPERT_ASKING_CHANNEL_TYPE='teams'

# Teams Configuration (required if EXPERT_ASKING_CHANNEL_TYPE="teams")
TEAMS_CHANNEL_ID='REPLACE_WITH_TEAMS_CHANNEL_ID'
TEAMS_TENANT_ID='REPLACE_WITH_TEAMS_TENANT_ID'
TEAMS_BOT_ID='REPLACE_WITH_TEAMS_BOT_ID'

# Slack Configuration (required if EXPERT_ASKING_CHANNEL_TYPE="slack")
SLACK_CHANNEL_ID=''
SLACK_SERVICE_URL='https://slack.botframework.com'

# -----------------------------------------------------------------------------
# OpenTelemetry Configuration (Optional)
# -----------------------------------------------------------------------------
OTEL_ENABLED='true'

# Cloud OTEL (optional - for external observability platforms)
OTEL_CLOUD_ENDPOINT='placeholder:1234'
OTEL_CLOUD_HEADERS=''

# -----------------------------------------------------------------------------
# Rclone RC API (Required for data ingestion)
# -----------------------------------------------------------------------------
RCLONE_URL='http://rclone:5572'
RCLONE_RC_USER='REPLACE_WITH_SECURE_USERNAME'
RCLONE_RC_PASS='REPLACE_WITH_SECURE_PASSWORD'

# -----------------------------------------------------------------------------
# Pipeline Run-Failure Notifications (Optional, Apprise)
# -----------------------------------------------------------------------------
NOTIFICATION_URLS=''
