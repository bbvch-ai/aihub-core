# =============================================================================
# AI-Hub Production Environment Configuration
# =============================================================================
# This file contains ONLY the environment variables that must be configured.
# All internal Docker network endpoints are hardcoded in the compose files.
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
LOG_LEVEL="INFO"
ENV="prod"
DOMAIN="REPLACE_WITH_YOUR_DOMAIN"

# Let's Encrypt / Traefik
ACME_EMAIL="admin@your-company.com"
ADMIN_PASSWORD_HASH=""

# -----------------------------------------------------------------------------
# API Keys (External Services) - Configure at least one LLM provider
# -----------------------------------------------------------------------------
AZURE_OPENAI_KEY="REPLACE_WITH_AZURE_OPENAI_KEY"
AZURE_OPENAI_BASE_URL="REPLACE_WITH_AZURE_OPENAI_BASE_URL"
GEMINI_API_KEY=""
JINA_API_KEY=""
HUGGINGFACE_API_KEY=""

# Optional providers
SWISS_LLM_CLOUD_API_BASE_URL=""
SWISS_LLM_CLOUD_API_KEY=""
COHERE_API_BASE=""
COHERE_API_KEY=""

# -----------------------------------------------------------------------------
# OAuth2 / OIDC Configuration (REQUIRED)
# -----------------------------------------------------------------------------
AUTH_IDENTITY_PROVIDER="sso"
OAUTH_PROVIDER_NAME="Azure AD"
OAUTH_CLIENT_ID="REPLACE_WITH_YOUR_CLIENT_ID"
OAUTH_CLIENT_SECRET="REPLACE_WITH_YOUR_CLIENT_SECRET"
OAUTH_AUTHORITY_URL="https://login.microsoftonline.com/REPLACE_WITH_YOUR_TENANT_ID"
OAUTH_TENANT_ID="REPLACE_WITH_YOUR_TENANT_ID"

# Azure-specific OAuth (same values as above)
AZURE_CLIENT_ID="REPLACE_WITH_YOUR_CLIENT_ID"
AZURE_TENANT_ID="REPLACE_WITH_YOUR_TENANT_ID"
AZURE_CLIENT_SECRET="REPLACE_WITH_YOUR_CLIENT_SECRET"

# OAuth Custom Branding (optional)
OAUTH_CUSTOM_SIGN_IN_LOGO=""

# -----------------------------------------------------------------------------
# Authentication & Security (REQUIRED - Generate new secrets!)
# -----------------------------------------------------------------------------
AUTH_OPEN_WEBUI_SIGNING_SECRET="REPLACE_WITH_RANDOM_STRING"

# Superuser Configuration
SUPERUSER_ENABLED="True"
SUPERUSER_NAME="AI-Hub Superuser"
SUPERUSER_EMAIL="admin@your-company.com"
SUPERUSER_OID="REPLACE_WITH_RANDOM_STRING"
SUPERUSER_ROLE="AIHubSuperuser"
SUPERUSER_TOKEN="REPLACE_WITH_RANDOM_STRING"

# -----------------------------------------------------------------------------
# Database Credentials (REQUIRED - Use strong passwords!)
# -----------------------------------------------------------------------------
# PostgreSQL
POSTGRES_USER="admin"
POSTGRES_PASSWORD="REPLACE_WITH_RANDOM_STRING"

# MongoDB (FerretDB)
MONGO_USERNAME="admin"
MONGO_PASSWORD="REPLACE_WITH_RANDOM_STRING"

# NEO4J
NEO4J_URL="bolt://neo4j:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="REPLACE_WITH_RANDOM_STRING"


# S3 Storage (SeaweedFS)
S3_STORAGE_ACCESS_KEY="admin"
S3_STORAGE_SECRET_KEY="REPLACE_WITH_RANDOM_STRING"
# Public endpoint for presigned URLs (used by browsers to download/upload files)
# This should be the externally accessible S3 endpoint via Traefik (e.g., https://s3.yourdomain.com)
# The value is auto-configured in docker-compose as https://s3.${DOMAIN}
# S3_STORAGE_PUBLIC_ENDPOINT="https://s3.${DOMAIN}"

# JWT signing key for internal SeaweedFS component authentication (Master, Volume, Filer, S3)
SEAWEEDFS_TOKEN="REPLACE_WITH_RANDOM_STRING"

# -----------------------------------------------------------------------------
# LiteLLM Configuration (REQUIRED)
# -----------------------------------------------------------------------------
LITELLM_UI_USERNAME="admin"
LITELLM_UI_PASSWORD="REPLACE_WITH_RANDOM_STRING"
LITELLM_MASTER_KEY="REPLACE_WITH_RANDOM_STRING"

# -----------------------------------------------------------------------------
# Local LLM (llama.cpp / hf-tei / vLLM) Configuration
# -----------------------------------------------------------------------------
LOCAL_LLM_TOKEN="REPLACE_WITH_RANDOM_STRING"

# -----------------------------------------------------------------------------
# Service Configuration
# -----------------------------------------------------------------------------
JUPYTER_TOKEN="REPLACE_WITH_RANDOM_STRING"

# Langfuse Configuration (LLM observability and evaluation)
# Langfuse server internals — generate with: openssl rand -hex 32
LANGFUSE_SALT="REPLACE_WITH_RANDOM_STRING"
LANGFUSE_NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_STRING"
# Must be exactly 64 hex characters — generate with: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARS"
# Public URL where Langfuse UI is reachable (used for NextAuth callback)
LANGFUSE_NEXTAUTH_URL="https://langfuse.${DOMAIN}"
# Convention: pk-lf-<random> / sk-lf-<random>
LANGFUSE_PUBLIC_KEY="pk-lf-REPLACE_WITH_LANGFUSE_PUBLIC_KEY"
LANGFUSE_SECRET_KEY="sk-lf-REPLACE_WITH_LANGFUSE_SECRET_KEY"
# Initial admin user created on first startup
LANGFUSE_INIT_USER_EMAIL="admin@your-company.com"
LANGFUSE_INIT_USER_PASSWORD="REPLACE_WITH_RANDOM_STRING"
LANGFUSE_CLICKHOUSE_PASSWORD="REPLACE_WITH_RANDOM_STRING"

# Langfuse SSO (Azure AD) — requires a dedicated app registration in Azure AD
# to restrict who can log into Langfuse. Separate from the main AI-Hub OAuth app.
LANGFUSE_AZURE_AD_CLIENT_ID="REPLACE_WITH_LANGFUSE_APP_CLIENT_ID"
LANGFUSE_AZURE_AD_CLIENT_SECRET="REPLACE_WITH_LANGFUSE_APP_CLIENT_SECRET"
LANGFUSE_AZURE_AD_TENANT_ID="REPLACE_WITH_AZURE_TENANT_ID"

# Langfuse Access Control
LANGFUSE_ALLOWED_ORGANIZATION_CREATORS="REPLACE_WITH_ADMIN_EMAIL"

# MinerU Configuration
MINERU_API_TIMEOUT="600"
MINERU_VLM_NAME="text-generation/ocr"
MINERU_FORMULA_ENABLE="true"
MINERU_TABLE_ENABLE="true"
MINERU_API_MAX_CONCURRENT_REQUESTS="10"

# Mem0
MEM0_LLM_NAME="text-generation/large"
MEM0_EMBEDDING_MODEL_NAME="embedding/large"
MEM0_RERANKING_MODEL_NAME="reranker"

# Milvus Configuration (must match your embedding model dimensions)
MILVUS_DIMENSION="3072"
MILVUS_ROOT_PASSWORD="REPLACE_WITH_RANDOM_STRING"

# Etcd Configuration
ETCD_TOKEN="REPLACE_WITH_RANDOM_STRING"

# NATS Configuration (for clients connecting to NATS messaging)
NATS_TOKEN="REPLACE_WITH_RANDOM_STRING"

# Redis/Valkey Configuration
REDIS_TOKEN="REPLACE_WITH_RANDOM_STRING"

# -----------------------------------------------------------------------------
# Multi-Tenant Configuration
# -----------------------------------------------------------------------------

# Default Tenant Settings
# Default tenant created on first startup (backwards-compatible single-tenant mode)
AIHUB_DEFAULT_TENANT_NAME="Default Organization"
AIHUB_DEFAULT_TENANT_DESCRIPTION="The default organization for all users."
# Access rules for the default tenant (comma-separated). Use "aihub.admin.>" for unrestricted admin access.
AIHUB_DEFAULT_TENANT_ACCESS_RULES="aihub.admin.>"

# User Signup Settings
# Default roles assigned to all new users (catch-all fallback)
AIHUB_USER_SIGNUP_DEFAULT_ROLES="AIHubUser"
# Roles assigned to regular users when they sign up (comma-separated)
AIHUB_USER_SIGNUP_REGULAR_USER_ROLES="AIHubUser"
# Roles assigned to the very first user (typically admin). Comma-separated.
AIHUB_USER_SIGNUP_FIRST_ADMIN_USER_ROLES="AIHubAdmin,AIHubUser"

# -----------------------------------------------------------------------------
# AI-Hub Application Settings
# -----------------------------------------------------------------------------
AIHUB_API_VERSION="latest"
AIHUB_CREATE_DEFAULT_ROLES="True"
AIHUB_CREATE_DEFAULT_BUCKETS="True"
AIHUB_DEFAULT_BUCKET_NAME="defaultknowledge"
AIHUB_SHARED_BUCKET_NAME="sharedknowledge"
AIHUB_DEFAULT_NAMESPACE_NAME="defaultnamespace"
AIHUB_SHARED_NAMESPACE_NAME="sharednamespace"

# Admin Settings
ADMIN_EMAIL="admin@your-company.com"

# OAuth Group Restrictions (Azure AD group names)
OAUTH_ALLOWED_GROUPS_DAGSTER="AIHubAdmin"
OAUTH_COOKIE_SECRET_DAGSTER="REPLACE_WITH_RANDOM_STRING"
OAUTH_ALLOWED_GROUPS_SEAWEEDFS="AIHubAdmin"
OAUTH_COOKIE_SECRET_SEAWEEDFS="REPLACE_WITH_RANDOM_STRING"
OAUTH_ALLOWED_GROUPS_ATTU="AIHubAdmin"
OAUTH_COOKIE_SECRET_ATTU="REPLACE_WITH_RANDOM_STRING"

# -----------------------------------------------------------------------------
# Expert Asking Agent Configuration (Required for expert escalation)
# -----------------------------------------------------------------------------
# Channel type: "teams" or "slack"
EXPERT_ASKING_CHANNEL_TYPE="teams"

# Teams Configuration (required if EXPERT_ASKING_CHANNEL_TYPE="teams")
TEAMS_CHANNEL_ID="REPLACE_WITH_TEAMS_CHANNEL_ID"
TEAMS_TENANT_ID="REPLACE_WITH_TEAMS_TENANT_ID"
TEAMS_BOT_ID="REPLACE_WITH_TEAMS_BOT_ID"

# Slack Configuration (required if EXPERT_ASKING_CHANNEL_TYPE="slack")
SLACK_CHANNEL_ID=""
SLACK_SERVICE_URL="https://slack.botframework.com"

# -----------------------------------------------------------------------------
# OpenTelemetry Configuration (Optional)
# -----------------------------------------------------------------------------
OTEL_ENABLED="true"

# Cloud OTEL (optional - for external observability platforms)
OTEL_CLOUD_ENDPOINT="placeholder:1234"
OTEL_CLOUD_HEADERS=""

# -----------------------------------------------------------------------------
# Rclone RC API (Required for data ingestion)
# -----------------------------------------------------------------------------
RCLONE_URL="http://rclone:5572"
RCLONE_RC_USER="REPLACE_WITH_SECURE_USERNAME"
RCLONE_RC_PASS="REPLACE_WITH_SECURE_PASSWORD"
