### Test: Get Locale Information
GET http://127.0.0.1:8000/i18n/my-locale
Accept: application/json

> {%
client.test("Response status is 200 OK", function() {
  client.assert(response.status === 200, "Expected status code is 200");
});

client.test("Response body contains correct locale data", function() {
  const body = response.body;
  client.assert(body.lang === "de", "Expected language to be 'de'");
  client.assert(body.test === "Das ist ein deutscher Test", "Expected test string to match");
});
%}
