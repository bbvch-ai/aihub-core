### Get User Threads
    GET http://localhost:8000/api/v1/thread
Accept: application/json

> {%
client.test("Status is 200 OK", () => {
  client.assert(response.status === 200, "Expected status code 200");
});

client.test("Threads list returns JSON", () => {
  client.assert(response.headers.valueOf("content-type") === "application/json", "Expected JSON response");
});

client.test("Threads list has 'threads' property", () => {
  const body = response.body;
  client.assert(body.threads && Array.isArray(body.threads), "Expected 'threads' to be an array");
});
%}


### Create a New Thread
POST http://localhost:8000/api/v1/thread/1234
Content-Type: application/json
Accept: application/json

{
  "name": "My New Thread",
  "user_ids": ["cc4af21b-981a-4a76-826d-e722715082e0"],
  "agents": [
    {
      "agent_id": "my_agent_id",
      "agent_class": "my_agent_class"
    }
  ]
}

> {%
client.test("Status is 200 OK", () => {
  client.assert(response.status === 200, "Expected status code 200");
});

client.test("Created thread returns correct structure", () => {
  const body = response.body;
  client.assert(typeof body.id === "string", "Expected 'id' field as a string");
  client.assert(typeof body.name === "string", "Expected 'name' field as a string");
  client.assert(Array.isArray(body.users), "Expected 'users' to be an array");
  client.assert(Array.isArray(body.agents), "Expected 'agents' to be an array");
});
%}


### Get a Specific Thread by ID
GET http://localhost:8000/api/v1/thread/675b291e687166c586322c08
Accept: application/json

> {%
client.test("Status is 200 OK", () => {
  client.assert(response.status === 200, "Expected status code 200");
});

client.test("Check thread structure", () => {
  const body = response.body;
  client.assert(typeof body.id === "string", "Expected 'id' as a string");
  client.assert(typeof body.name === "string", "Expected 'name' as a string");
  client.assert(Array.isArray(body.users), "Expected 'users' as an array");
  client.assert(Array.isArray(body.agents), "Expected 'agents' as an array");
});
%}


### Add an Agent to a Thread
POST http://localhost:8000/api/v1/thread/675b291e687166c586322c08/agents
Content-Type: application/json
Accept: application/json

{
  "agent_id": "my_agent_id",
  "agent_class": "my_agent_class"
}

> {%
client.test("Status is 200 OK", () => {
  client.assert(response.status === 200, "Expected status code 200");
});

client.test("Agent was added", () => {
  const body = response.body;
  const agentIds = body.agents.map(a => a.agent_id);
  client.assert(agentIds.includes("agent_456"), "Expected the newly added agent to appear in 'agents'");
});
%}


### Remove an Agent from a Thread
DELETE http://localhost:8000/api/v1/thread/675b291e687166c586322c08/agents/my_agent_class/my_agent_id
Accept: application/json

> {%
client.test("Status is 200 OK", () => {
  client.assert(response.status === 200, "Expected status code 200");
});

client.test("Agent was removed", () => {
  const body = response.body;
  const agentIds = body.agents.map(a => a.agent_id);
  client.assert(!agentIds.includes("agent_456"), "Expected the agent to be removed from 'agents'");
});
%}


### Add a User to a Thread
POST http://localhost:8000/api/v1/thread/675b291e687166c586322c08/users
Content-Type: application/json
Accept: application/json

{
  "user_id": "new_user_id"
}

> {%
client.test("Status is 200 OK", () => {
  client.assert(response.status === 200, "Expected status code 200");
});

client.test("User was added", () => {
  const body = response.body;
  const userIds = body.users.map(u => u.user_id);
  client.assert(userIds.includes("new_user_id"), "Expected the newly added user to appear in 'users'");
});
%}


### Remove a User from a Thread
DELETE http://localhost:8000/api/v1/thread/675b291e687166c586322c08/users/new_user_id
Accept: application/json

> {%
client.test("Status is 200 OK", () => {
  client.assert(response.status === 200, "Expected status code 200");
});

client.test("User was removed", () => {
  const body = response.body;
  const userIds = body.users.map(u => u.user_id);
  client.assert(!userIds.includes("new_user_id"), "Expected the user to be removed from 'users'");
});
%}
