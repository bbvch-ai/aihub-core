# Use Ubuntu 22.04 as the base image
FROM ubuntu:22.04 AS builder

# Avoid interactive prompts and set timezone
ENV DEBIAN_FRONTEND=noninteractive TZ=UTC
ENV CCACHE_DIR=/root/.cache/ccache
ENV CMAKE_CXX_COMPILER_LAUNCHER=ccache

# Install system packages and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ccache \
    curl \
    ffmpeg \
    g++-12 \
    gcc-12 \
    git \
    libgl1 \
    libnuma-dev \
    libsm6 \
    libtcmalloc-minimal4 \
    libxext6 \
    numactl \
    python3 \
    python3-dev \
    python3-pip \
    vim \
    wget \
 && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 10 \
      --slave /usr/bin/g++ g++ /usr/bin/g++-12 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* \
# Upgrade pip and install necessary Python dependencies
 && pip3 install --no-cache-dir --upgrade pip \
 && pip3 install --no-cache-dir \
        intel-openmp==2025.0.1 \
        intel_extension_for_pytorch==2.5.0

# Clone the vLLM repository
WORKDIR /workspace
RUN git clone https://github.com/vllm-project/vllm.git

# Build the Python wheel
WORKDIR /workspace/vllm
ARG PIP_EXTRA_INDEX_URL="https://download.pytorch.org/whl/cpu"
ENV PIP_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL}
ARG VLLM_CPU_DISABLE_AVX512
ENV VLLM_CPU_DISABLE_AVX512=${VLLM_CPU_DISABLE_AVX512}
RUN pip3 install --no-cache-dir -r requirements-common.txt \
    && pip3 install --no-cache-dir -r requirements-build.txt \
    && pip3 install --no-cache-dir -r requirements-cpu.txt \
    && VLLM_TARGET_DEVICE=cpu python3 setup.py bdist_wheel

# Runtime Stage
FROM ubuntu:22.04

# Avoid interactive prompts and set timezone
ENV DEBIAN_FRONTEND=noninteractive TZ=UTC

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libnuma-dev \
    libsm6 \
    libtcmalloc-minimal4 \
    libxext6 \
    numactl \
    python3 \
    python3-pip \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Configure TCMalloc and Intel OpenMP preloading
ENV LD_PRELOAD="/usr/lib/x86_64-linux-gnu/libtcmalloc_minimal.so.4:/usr/local/lib/libiomp5.so"

# Copy built artifacts from the builder
COPY --from=builder /workspace/vllm/dist/*.whl /workspace/

# Install the vLLM Python wheel
ARG PIP_EXTRA_INDEX_URL="https://download.pytorch.org/whl/cpu"
ENV PIP_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL}
RUN pip3 install --no-cache-dir /workspace/*.whl && rm -rf /workspace/*.whl \
 && pip3 install --no-cache-dir intel-openmp==2025.0.1 \
 && pip3 install --no-cache-dir intel_extension_for_pytorch==2.5.0

# Set up the workspace
WORKDIR /workspace
COPY --from=builder /workspace/vllm /workspace/vllm

# Create symbolic links for tests, examples, and benchmarks
RUN ln -s vllm/tests . && ln -s vllm/examples . && ln -s vllm/benchmarks .

# Set the default entrypoint for the container
CMD ["python3", "-m", "vllm.entrypoints.openai.api_server"]
