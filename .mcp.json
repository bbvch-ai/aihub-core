{
  "mcpServers": {
    "mongodb": {
      "command": "./.claude/mcp/mcp-mongodb.sh"
    },
    "swiss_ai_hub_api": {
      "type": "http",
      "url": "http://localhost:8000/mcp/",
      "headersHelper": "./.claude/mcp/mcp-swiss-ai-hub-api-headers.sh"
    },
    "langfuse": {
      "type": "http",
      "url": "http://localhost:6006/api/public/mcp",
      "headersHelper": "./.claude/mcp/mcp-langfuse-headers.sh"
    },
    "context7": {
      "command": "./.claude/mcp/mcp-context7.sh"
    },
    "playwright": {
      "command": "./.claude/mcp/mcp-playwright.sh"
    },
    "postgres": {
      "command": "./.claude/mcp/mcp-postgres.sh"
    },
    "primevue": {
      "command": "./.claude/mcp/mcp-primevue.sh"
    },
    "nuxt": {
      "type": "http",
      "url": "https://nuxt.com/mcp"
    },
    "milvus": {
      "command": "./.claude/mcp/mcp-milvus.sh"
    },
    "nats": {
      "command": "./.claude/mcp/mcp-nats.sh"
    },
    "dagster": {
      "command": "./.claude/mcp/mcp-dagster.sh"
    },
    "likec4": {
      "command": "./.claude/mcp/mcp-likec4.sh"
    },
    "redis": {
      "command": "./.claude/mcp/mcp-redis.sh"
    },
    "sonarqube": {
      "command": "./.claude/mcp/mcp-sonarqube.sh"
    }
  }
}
