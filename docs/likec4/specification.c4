specification {
  // bbv brand red — matches --vp-c-red-1 in docs/.vitepress/theme/custom.css.
  // Used by actors + the SUT + first-party APPLICATION-tier containers ("the stuff we build").
  // Infrastructure tiers are colour-coded (see per-element styles in the model) so a
  // container's tier is readable in every view, not just the grouped ones:
  //   app = aihub-red · data = slate · llm = secondary(purple) · eventing = amber
  //   identity/edge = indigo · observability = green · utility = gray · external = muted
  color aihub-red #bd0007

  // C4 element kinds. Names match canonical C4 vocabulary; LikeC4 itself is kind-agnostic.
  element person {
    notation "Person"
    style { shape person; color aihub-red }
  }

  element softwareSystem {
    notation "Software System (SUT)"
    style { color aihub-red }
  }

  element externalSystem {
    notation "External System"
    style { color muted }
  }

  element container {
    notation "Container"
    style { color aihub-red }
  }

  // Specialised container kinds carry both a distinguishing SHAPE and a tier-default COLOUR.
  // webapp = app-tier (red); datastore = data-tier (slate); messagebroker = eventing (amber).
  element webapp {
    notation "Web UI Container"
    style { color aihub-red; shape browser }
  }

  element datastore {
    notation "Data Store Container"
    style { color slate; shape storage }
  }

  element messagebroker {
    notation "Message Broker Container"
    style { color amber; shape queue }
  }

  element component {
    notation "Component"
    style { color aihub-red }
  }

  // Relationship kinds — distinguished by colour, line style, and arrowhead.
  //   sync     = synchronous request/response (solid, filled arrow)
  //   async    = fire-and-forget / event-bus hop (dotted, open vee)
  //   federate = SSO / OIDC trust link (dashed, diamond)
  //   ingress  = reverse-proxy routing from the edge (solid, open arrow)
  relationship sync     { color slate; line solid;  head normal }
  relationship async    { color amber; line dotted; head vee }
  relationship federate { color sky;   line dashed; head diamond }
  relationship ingress  { color indigo; line solid; head open }

  // Tags. Applied to elements via `#tag` syntax; used for filtering in views.
  tag external
  tag sysadmin
  tag stateful
  tag stateless
  tag oidc-middleware
  tag prod-only
  tag host-network

  // L2 tier tags. Each container carries exactly one. Views slice by tag.
  tag tier-application
  tag tier-llm
  tag tier-data
  tag tier-eventing
  tag tier-identity-edge
  tag tier-observability
  tag tier-utility
}
