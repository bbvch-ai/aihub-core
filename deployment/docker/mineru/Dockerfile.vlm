# MinerU VLM Container (GPU-enabled)
#
# This container runs the MinerU Vision-Language Model for document parsing.
# It downloads and serves the MinerU2.5 model for OCR and document understanding.
#
# Requirements:
# - NVIDIA GPU with CUDA support
# - Docker with NVIDIA runtime

FROM vllm/vllm-openai:v0.10.1.1

# Install system dependencies for MinerU
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        fonts-noto-core \
        fonts-noto-cjk \
        fontconfig \
        libgl1 && \
    fc-cache -fv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install MinerU with full capabilities including local model support
RUN python3 -m pip install -U 'mineru[core]>=2.7.0' --break-system-packages && \
    python3 -m pip cache purge

# Download all MinerU models from HuggingFace
# This is done at build time to avoid download delays at runtime
RUN /bin/bash -c "mineru-models-download -s huggingface -m all"

# Set environment to use local models
ENV MINERU_MODEL_SOURCE=local

EXPOSE 30000

# Run vLLM server with MinerU model
# The entrypoint ensures MINERU_MODEL_SOURCE=local is set
ENTRYPOINT ["/bin/bash", "-c", "export MINERU_MODEL_SOURCE=local && exec \"$@\"", "--"]
CMD ["python3", "-m", "vllm.entrypoints.openai.api_server", \
     "--model", "opendatalab/MinerU2.5-2509-1.2B", \
     "--host", "0.0.0.0", \
     "--port", "30000", \
     "--trust-remote-code"]
