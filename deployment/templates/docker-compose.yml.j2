  # ===================================================================
  # Bot Service (MS Teams Integration)
  # ===================================================================
  # This service provides MS Teams bot integration for the AI Hub.
  # ===================================================================
  bot:
    container_name: bot
    restart: always
    {%- if image_tags.bot[stage] == 'localbuild' %}
    build:
      context: .
      dockerfile: ./aihub_bot/Dockerfile
    {%- else %}
    image: {{ global.registry_prefix }}{{ image_tags.bot[stage] }}
    {%- endif %}
    depends_on:
      ferretdb:
        condition: service_started
      nats:
        condition: service_started
      traefik:
        condition: service_started
      neo4j:
          condition: service_healthy
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "8001:8001"
    {%- endif %}
    environment:
      NATS_ENDPOINT: {{ NATS_ENDPOINT }}
      NATS_TOKEN: ${NATS_TOKEN}
      MONGO_CONNECTION_STRING: mongodb://${MONGO_USERNAME}:${MONGO_PASSWORD}@ferretdb:27017/
      NEO4J_URL: bolt://neo4j:7687
      NEO4J_USERNAME: ${NEO4J_USERNAME}
      NEO4J_PASSWORD: ${NEO4J_PASSWORD}
      MEM0_LLM_NAME: "text-generation/large"
      MEM0_EMBEDDING_MODEL_NAME: "embedding/large"
      MEM0_RERANKING_MODEL_NAME: "reranker"
      LOG_LEVEL: ${LOG_LEVEL}
      NUM_WORKERS: 1
      AIHUB_API_VERSION: ${AIHUB_API_VERSION}
      AIHUB_FRONTEND_ORIGIN: ${DOMAIN}
      DANGEROUS_DEV_ONLY_AUTH_FAKE_NAME: ${BOT_AUTH_FAKE_NAME}
      DANGEROUS_DEV_ONLY_AUTH_FAKE_EMAIL: ${BOT_AUTH_FAKE_EMAIL}
      DANGEROUS_DEV_ONLY_AUTH_FAKE_OID: ${BOT_AUTH_FAKE_OID}
      DANGEROUS_DEV_ONLY_AUTH_FAKE_ROLES: ${BOT_AUTH_FAKE_ROLES}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8001/api/v1/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    {%- if stage not in ['dev'] %}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      - "traefik.http.routers.bot.rule=Host(`bot.${DOMAIN}`)"
      - "traefik.http.routers.bot.entrypoints=websecure"
      - "traefik.http.routers.bot.tls=true"
      - "traefik.http.routers.bot.middlewares=security-headers@file"
      - "traefik.http.services.bot.loadbalancer.server.port=8001"
    {%- endif %}
    networks:
      - proxy
      - backend
      - data
  {%- endif %}

# ===================================================================
# Network Configuration
# ===================================================================
# Network isolation provides defense-in-depth security by limiting
# which services can communicate with each other. Each network zone
# serves a specific purpose:
#
# - proxy:   External traffic ingress (Traefik routes here)
# - backend: Internal application and processing services
# - data:    Databases, caches, and message broker
# - storage: SeaweedFS distributed object storage
# - egress:  Outbound internet only, ICC disabled (containers isolated)
#
# Services are assigned to only the networks they require.
# Networks marked with 'internal: true' cannot be accessed from
# outside the Docker network, even if ports are exposed.
# ===================================================================
networks:
  proxy:
    name: proxy
    driver: bridge
  backend:
    name: backend
    driver: bridge
    {%- if stage != 'dev' %}
    internal: true
    {%- endif %}
  data:
    name: data
    driver: bridge
    {%- if stage != 'dev' %}
    internal: true
    {%- endif %}
  storage:
    name: storage
    driver: bridge
    {%- if stage != 'dev' %}
    internal: true
    {%- endif %}
  egress:
    name: egress
    driver: bridge
    driver_opts:
      com.docker.network.bridge.enable_icc: "false"

{%- if stage == 'dev' %}
# ===================================================================
# Named Volumes
# ===================================================================
# ClickHouse requires Linux filesystem semantics (atomic rename) that
# are not supported by Windows bind mounts. Named Docker volumes run
# inside the Docker VM where this works correctly.
# ===================================================================
volumes:
  clickhouse-data:
  clickhouse-logs:
{%- endif %}
