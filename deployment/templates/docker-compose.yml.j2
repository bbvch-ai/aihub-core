      {%- else %}
      - "traefik.http.routers.api.tls=true"
      {%- endif %}
    networks:
      - proxy
      - backend
      - data
      - storage
  {%- endif %}

  {% if image_tags.web[stage] %}
  # ===================================================================
  # Suite UI Stack (Frontend)
  # ===================================================================
  # This is the main SvelteKit frontend for the AI Hub. It is not
  # present in the 'dev' stage.
  # ===================================================================
  web:
    container_name: web
    restart: always
    {%- if image_tags.web[stage] == 'localbuild' %}
    build:
      context: ./aihub_web/aihub_web
      dockerfile: ./Dockerfile
    {%- else %}
    image: {{ global.registry_prefix }}{{ image_tags.web[stage] }}
    {%- endif %}
    environment:
      OAUTH_CLIENT_ID: ${OAUTH_CLIENT_ID}
      OAUTH_AUTHORITY_URL: ${OAUTH_AUTHORITY_URL}
      WEBUI_URL: https://openwebui.${DOMAIN}
      WS_ENDPOINT: wss://${DOMAIN}/api/v1/events/ws
      IDENTITY_PROVIDERS: ${IDENTITY_PROVIDERS}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://127.0.0.1/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - proxy  # Static frontend only needs proxy access
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      # --- Routers ---
      - "traefik.http.routers.web-static.rule=Host(`${DOMAIN}`) && PathPrefix(`/_nuxt`)"
      - "traefik.http.routers.web-static.priority=2000"
      - "traefik.http.routers.web-static.entrypoints=websecure"
      - "traefik.http.routers.web-static.middlewares=web-standard-middleware"
      - "traefik.http.routers.web-auth.rule=Host(`${DOMAIN}`) && (PathPrefix(`/en/auth`) || PathPrefix(`/de/auth`) || PathPrefix(`/fr/auth`) || PathPrefix(`/it/auth`))"
      - "traefik.http.routers.web-auth.priority=750"
      - "traefik.http.routers.web-auth.entrypoints=websecure"
      - "traefik.http.routers.web-auth.middlewares=web-standard-middleware"
      - "traefik.http.routers.web-index.rule=Host(`${DOMAIN}`) && (Path(`/`) || Path(`/index.html`) || Path(`/config.json`))"
      - "traefik.http.routers.web-index.priority=400"
      - "traefik.http.routers.web-index.entrypoints=websecure"
      - "traefik.http.routers.web-index.middlewares=web-standard-middleware"
      - "traefik.http.routers.web-default.rule=Host(`${DOMAIN}`)"
      - "traefik.http.routers.web-default.priority=100"
      - "traefik.http.routers.web-default.entrypoints=websecure"
      - "traefik.http.routers.web-default.middlewares=web-standard-middleware"
      # --- TLS Resolver Logic ---
      {%- if stage not in ['local', 'build'] %}
      - "traefik.http.routers.web-static.tls.certresolver=letsencrypt"
      - "traefik.http.routers.web-auth.tls.certresolver=letsencrypt"
      - "traefik.http.routers.web-index.tls.certresolver=letsencrypt"
      - "traefik.http.routers.web-default.tls.certresolver=letsencrypt"
      {%- else %}
      - "traefik.http.routers.web-static.tls=true"
      - "traefik.http.routers.web-auth.tls=true"
      - "traefik.http.routers.web-index.tls=true"
      - "traefik.http.routers.web-default.tls=true"
      {%- endif %}
      # --- Service & Middleware ---
      - "traefik.http.services.web.loadbalancer.server.port=80"
      - "traefik.http.middlewares.web-standard-middleware.chain.middlewares=security-headers@file"
  {%- endif %}

