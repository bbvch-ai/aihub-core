    These are the internal Docker network endpoints that never change
    between stages or hardware variants. They are hardcoded here to
    avoid unnecessary environment variable indirection.
    =================================================================== #}
{%- set SEAWEEDFS_MASTER_ENDPOINT = "seaweedfs-master:9333" %}
{%- set SEAWEEDFS_FILER_ENDPOINT = "seaweedfs-filer:8888" %}
{%- set SEAWEEDFS_S3_ENDPOINT = "seaweedfs-s3:9000" %}
{%- set SEAWEEDFS_FILER_URL = "http://seaweedfs-filer:8888" %}
{%- set S3_STORAGE_ENDPOINT = "http://seaweedfs-s3:9000" %}
{%- set S3_STORAGE_PUBLIC_ENDPOINT = "http://localhost:9000" if stage == 'dev' else "https://s3.${DOMAIN}" %}
{%- set ETCD_ENDPOINTS = "etcd:2379" %}
{%- set MILVUS_ENDPOINT = "http://milvus-standalone:19530" %}
{%- set MILVUS_HOST = "milvus-standalone" %}
{%- set MILVUS_PORT = "19530" %}
{%- set LANGFUSE_BASE_URL = "http://langfuse-web:3000" %}
{%- set NATS_ENDPOINT = "nats://nats:4222" %}
{%- set REDIS_ENDPOINT = "redis://valkey:6379" %}
{%- set LITE_LLM_PROXY_BASE_URL = "http://litellm:4000" %}
{%- set JUPYTER_URL = "http://jupyter:8888" %}
{%- set MINERU_API_BASE_URL = "http://mineru-api:8000" %}
{%- set PRESIDIO_ANALYZER_API_BASE = "http://presidio-analyzer:3000" %}
{%- set PRESIDIO_ANONYMIZER_API_BASE = "http://presidio-anonymizer:3000" %}
{%- set PLAYWRIGHT_WS_URL = "ws://playwright:3000" %}
{%- set DAGSTER_WEBSERVER_URL = "http://dagster-webserver:3000" %}
{%- set OTEL_EXPORTER_OTLP_ENDPOINT = "http://otel-collector:4317" %}
{%- set KEYCLOAK_INTERNAL_URL = "http://keycloak:8080" %}
{%- set KEYCLOAK_REALM = "aihub" %}

{#- ===================================================================
    Extract version tag from image string for OpenTelemetry versioning
    ===================================================================
    In production (local/nightly/latest), we want OTEL_RESOURCE_SERVICE_VERSION
    to match the Docker image tag for accurate version tracking.

    Examples:
      - "api:nightly" → "nightly"
      - "api:latest" → "latest"
      - "localbuild" → ${OTEL_RESOURCE_SERVICE_VERSION} (env var fallback)
    =================================================================== #}
{%- macro get_service_version(service_name) -%}
  {%- set image_tag = image_tags[service_name][stage] -%}
  {%- if image_tag and image_tag != 'localbuild' and ':' in image_tag -%}
    {{ image_tag.split(':')[1] }}
  {%- else -%}
    ${OTEL_RESOURCE_SERVICE_VERSION}
  {%- endif -%}
{%- endmacro -%}

{% if stage != 'dev' %}
# ===================================================================
# TRAEFIK PRIORITY RULES
# ===================================================================
#
# This file follows state-of-the-art Traefik routing priority best practices:
#
# RULE: Higher priority numbers = more specific routes (evaluated first)
# RULE: Leave gaps of 100-500 between priority tiers for future expansion
# RULE: Use consistent ranges for similar route types across services
#
# PRIORITY HIERARCHY (10000 → 1):
#
# 10000-9000: SYSTEM & INFRASTRUCTURE
#   - 10000: Emergency overrides
#   - 9500:  Health checks, monitoring endpoints
#   - 9000:  ACME/Let's Encrypt challenges
#
# 8000-7000: SECURITY & AUTHENTICATION
#   - 8000:  Rate limiting, IP blocking
#   - 7500:  OAuth callbacks, OIDC endpoints
#   - 7000:  Authentication APIs, login endpoints
#
# 6000-5000: APPLICATION APIs
#   - 6000:  Specific API endpoints (e.g., /api/v1/auth)
#   - 5500:  Versioned API routes (e.g., /api/v2)
#   - 5000:  General API routes (e.g., /api)
#
# 4000-3000: APPLICATION FEATURES
#   - 4000:  Admin interfaces, management UIs
#   - 3500:  User-specific routes (e.g., /user/profile)
#   - 3000:  Feature-specific paths (e.g., /reports, /dashboard)
#
# 2500-1500: STATIC CONTENT & ASSETS
#   - 2500:  CDN, external assets
#   - 2000:  Static files (JS, CSS, images)
#   - 1500:  Application-specific assets, uploads
#
# 1000-500: GENERAL ROUTES
#   - 1000:  Service-specific catch-all routes
#   - 750:   Language/locale routing (e.g., /en, /de)
#   - 500:   Subdomain routing (service.domain.com)
#
# 400-1: FALLBACK & DEFAULT
#   - 400:   Domain catch-all with path restrictions
#   - 100:   Default domain catch-all
#   - 50:    Global fallback handlers
#   - 10:    HTTP to HTTPS redirect (non-ACME)
#
# NAMING CONVENTIONS:
#   - Router names: {service}-{type}-{variant}
#   - Examples: openwebui-api-auth, web-static-assets, minio-admin-ui
#   - Middleware chains: {service}-{purpose}-middleware
#
# ===================================================================
{%- endif %}

services:
  # ===================================================================
  # SeaweedFS Stack (Distributed Object Storage)
  # ===================================================================
  # This stack provides S3-compatible storage for the entire platform.
  # ===================================================================

  seaweedfs-master:
    container_name: seaweedfs-master
    image: {{ global.registry_prefix }}{{ image_tags.seaweedfs }}
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    expose:
      - "9333"   # Master HTTP port
      - "19333"  # Master gRPC port
    {%- endif %}
    command: >
      master
      -ip=seaweedfs-master
      -ip.bind=0.0.0.0
      -defaultReplication=000
      {%- if stage in ['dev', 'local', 'build'] %}
      -volumeSizeLimitMB=1024
      {%- else %}
      -volumeSizeLimitMB=29000
      {%- endif %}
      -volumePreallocate=false
    environment:
      WEED_JWT_SIGNING_KEY: ${SEAWEEDFS_TOKEN}
    volumes:
      - {{ global.volume_root }}/seaweedfs-master:/data
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:9333/dir/status"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - storage

  seaweedfs-volume:
    container_name: seaweedfs-volume
    image: "{{ global.registry_prefix }}{{ image_tags.seaweedfs }}"
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    expose:
      - "8080"
      - "18080"
    {%- endif %}
    command: >
      volume
      -mserver="{{ SEAWEEDFS_MASTER_ENDPOINT }}"
      -ip.bind=0.0.0.0
      -port=8080
      -max=100
      -dataCenter=dc1
    environment:
      WEED_JWT_SIGNING_KEY: ${SEAWEEDFS_TOKEN}
    volumes:
      - {{ global.volume_root }}/seaweedfs-volume:/data
    depends_on:
      seaweedfs-master:
        condition: service_healthy
    labels:
      healthcheck.enabled: "true"
      healthcheck.protocol: "http"
      healthcheck.port: "8080"
      healthcheck.path: "/status"
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - storage

  seaweedfs-filer:
    container_name: seaweedfs-filer
    image: {{ global.registry_prefix }}{{ image_tags.seaweedfs }}
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "8889:8888"
      - "18888"
    {%- endif %}
    command: >
      filer
      -master="{{ SEAWEEDFS_MASTER_ENDPOINT }}"
      -ip.bind=0.0.0.0
    environment:
      # Internal JWT Authentication
      WEED_JWT_SIGNING_KEY: ${SEAWEEDFS_TOKEN}

      # Etcd Configuration (SeaweedFS reads WEED_ETCD_* env vars)
      WEED_ETCD_ENABLED: "true"
      WEED_ETCD_SERVERS: http://etcd:2379
      WEED_ETCD_TIMEOUT: 3s
      WEED_ETCD_USERNAME: root
      WEED_ETCD_PASSWORD: ${ETCD_TOKEN}

      # Disable default leveldb2 store when using etcd
      WEED_LEVELDB2_ENABLED: "false"
    volumes:
      - {{ global.volume_root }}/seaweedfs-filer:/data
    depends_on:
      seaweedfs-master:
        condition: service_started
      seaweedfs-volume:
        condition: service_started
      etcd-init:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8888/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - storage
      - data  # For etcd access

  seaweedfs-s3:
    container_name: seaweedfs-s3
    image: {{ global.registry_prefix }}{{ image_tags.seaweedfs }}
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "9000:9000"
    {%- endif %}
    volumes:
      - ./configs/seaweedfs/s3-entrypoint.sh:/usr/local/bin/s3-entrypoint.sh:ro
    entrypoint: ["/bin/sh", "/usr/local/bin/s3-entrypoint.sh"]
    environment:
      # S3 Authentication
      SEAWEEDFS_S3_USER: ${S3_STORAGE_ACCESS_KEY}
      SEAWEEDFS_S3_PASSWORD: ${S3_STORAGE_SECRET_KEY}

      # Internal JWT Authentication
      WEED_JWT_SIGNING_KEY: ${SEAWEEDFS_TOKEN}

      # S3 Service Configuration
      S3_PORT: "9000"
      S3_FILER: "{{ SEAWEEDFS_FILER_ENDPOINT }}"
      S3_BIND_IP: "0.0.0.0"
      S3_ALLOW_EMPTY_FOLDER: true
    depends_on:
      seaweedfs-filer:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:9000/status"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    {%- if stage != 'dev' %}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      - "traefik.http.routers.seaweedfs-s3.rule=Host(`s3.${DOMAIN}`)"
      - "traefik.http.routers.seaweedfs-s3.priority=4000"
      - "traefik.http.routers.seaweedfs-s3.entrypoints=websecure"
      {%- if stage not in ['local', 'build'] %}
      - "traefik.http.routers.seaweedfs-s3.tls.certresolver=letsencrypt"
      {%- else %}
      - "traefik.http.routers.seaweedfs-s3.tls=true"
      {%- endif %}
      - "traefik.http.routers.seaweedfs-s3.middlewares=security-headers@file"
      - "traefik.http.services.seaweedfs-s3.loadbalancer.server.port=9000"
    {%- endif %}
    networks:
      - storage
      - backend  # Internal access from application services
      {%- if stage != 'dev' %}
      - proxy    # External S3 API access via Traefik
      {%- endif %}

  seaweedfs-init:
    container_name: seaweedfs-init
    image: {{ global.registry_prefix }}{{ image_tags.aws_cli }}
    restart: "no"
    depends_on:
      seaweedfs-s3:
        condition: service_healthy
    environment:
      AWS_ACCESS_KEY_ID: ${S3_STORAGE_ACCESS_KEY}
      AWS_SECRET_ACCESS_KEY: ${S3_STORAGE_SECRET_KEY}
      S3_ENDPOINT: http://seaweedfs-s3:9000
      AIHUB_CREATE_DEFAULT_BUCKETS: ${AIHUB_CREATE_DEFAULT_BUCKETS}
      AIHUB_DEFAULT_BUCKET_NAME: ${AIHUB_DEFAULT_BUCKET_NAME}
      AIHUB_SHARED_BUCKET_NAME: ${AIHUB_SHARED_BUCKET_NAME}
    volumes:
      - ./configs/seaweedfs/init-buckets.sh:/usr/local/bin/init-buckets.sh:ro
    entrypoint: [ "/bin/sh", "/usr/local/bin/init-buckets.sh" ]
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - storage
      - backend

  {% if stage != 'dev' -%}
  oauth2proxy-seaweed:
    container_name: oauth2proxy-seaweed
    image: {{ image_tags.oauth2proxy }}
    restart: always
    environment:
      OAUTH2_PROXY_HTTP_ADDRESS: 0.0.0.0:4181
      OAUTH2_PROXY_COOKIE_SECURE: False
      OAUTH2_PROXY_CODE_CHALLENGE_METHOD: S256
      OAUTH2_PROXY_UPSTREAMS: {{ SEAWEEDFS_FILER_URL }}
      OAUTH2_PROXY_ALLOWED_GROUPS: ${OAUTH_ALLOWED_GROUPS_SEAWEEDFS}
      OAUTH2_PROXY_OIDC_GROUPS_CLAIM: roles
      OAUTH2_PROXY_SCOPE: openid email profile roles
      OAUTH2_PROXY_CLIENT_ID: oauth2-proxy-datalake
      OAUTH2_PROXY_PROVIDER: oidc
      OAUTH2_PROXY_PROVIDER_DISPLAY_NAME: ${OAUTH_PROVIDER_NAME}
      OAUTH2_PROXY_SKIP_OIDC_DISCOVERY: "true"
      OAUTH2_PROXY_OIDC_ISSUER_URL: https://auth.${DOMAIN}/realms/{{ KEYCLOAK_REALM }}
      OAUTH2_PROXY_LOGIN_URL: https://auth.${DOMAIN}/realms/{{ KEYCLOAK_REALM }}/protocol/openid-connect/auth
      OAUTH2_PROXY_REDEEM_URL: {{ KEYCLOAK_INTERNAL_URL }}/realms/{{ KEYCLOAK_REALM }}/protocol/openid-connect/token
      OAUTH2_PROXY_OIDC_JWKS_URL: {{ KEYCLOAK_INTERNAL_URL }}/realms/{{ KEYCLOAK_REALM }}/protocol/openid-connect/certs
      OAUTH2_PROXY_COOKIE_SECRET: ${OAUTH_COOKIE_SECRET_SEAWEEDFS}
      OAUTH2_PROXY_CLIENT_SECRET: ${KEYCLOAK_OAUTH2_PROXY_DATALAKE_SECRET}
      OAUTH2_PROXY_EMAIL_DOMAINS: "*"
      OAUTH2_PROXY_CUSTOM_SIGN_IN_LOGO: ${OAUTH_CUSTOM_SIGN_IN_LOGO}
      OAUTH2_PROXY_REVERSE_PROXY: True
      OAUTH2_PROXY_REDIRECT_URL: https://datalake.${DOMAIN}
    depends_on:
      seaweedfs-filer:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      - "traefik.http.routers.seaweedfs-filer.rule=Host(`datalake.${DOMAIN}`)"
      - "traefik.http.routers.seaweedfs-filer.priority=4000"
      - "traefik.http.routers.seaweedfs-filer.entrypoints=websecure"
      {%- if stage not in ['local', 'build'] %}
      - "traefik.http.routers.seaweedfs-filer.tls.certresolver=letsencrypt"
      {%- else %}
      - "traefik.http.routers.seaweedfs-filer.tls=true"
      {%- endif %}
      - "traefik.http.routers.seaweedfs-filer.middlewares=security-headers@file"
      - "traefik.http.services.seaweedfs-filer.loadbalancer.server.port=4181"
    networks:
      - proxy
      - storage
  {% endif %}

  # ===================================================================
  # Milvus Stack (Vector Database)
  # ===================================================================
  # This stack provides vector storage and search for RAG capabilities.
  # ===================================================================

  etcd:
    container_name: etcd
    image: {{ global.registry_prefix }}{{ image_tags.etcd }}
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    command:
      - etcd
      - --name=s1
      - --data-dir=/etcd
      - --listen-client-urls=http://0.0.0.0:2379
      - --advertise-client-urls=http://etcd:2379
      - --listen-peer-urls=http://0.0.0.0:2380
      - --initial-advertise-peer-urls=http://etcd:2380
      - --initial-cluster=s1=http://etcd:2380
      - --auth-token=simple
    {%- else %}
    command:
      - etcd
      - --name=s1
      - --data-dir=/etcd
      - --listen-client-urls=http://0.0.0.0:2379
      - --advertise-client-urls=http://127.0.0.1:2379
      - --listen-peer-urls=http://0.0.0.0:2380
      - --initial-advertise-peer-urls=http://127.0.0.1:2380
      - --initial-cluster=s1=http://127.0.0.1:2380
      - --auth-token=simple
    {%- endif %}
    environment:
      ETCD_AUTO_COMPACTION_MODE: revision
      ETCD_AUTO_COMPACTION_RETENTION: 1000
      ETCD_QUOTA_BACKEND_BYTES: 4294967296
      ETCD_SNAPSHOT_COUNT: 50000
      # Token for healthcheck (used after auth is enabled by etcd-init)
      ETCD_TOKEN: ${ETCD_TOKEN}
    volumes:
      - {{ global.volume_root }}/etcd-data:/etcd
    healthcheck:
      # Use credentials for healthcheck to work after auth is enabled
      test: [ "CMD", "etcdctl", "--user=root:${ETCD_TOKEN}", "endpoint", "health" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data     # Milvus metadata storage
      - storage  # SeaweedFS filer metadata

  etcd-init:
    container_name: etcd-init
    build:
      context: ./configs/etcd
      dockerfile: init.Dockerfile
    restart: "no"
    depends_on:
      etcd:
        condition: service_started
    environment:
      ETCDCTL_ENDPOINTS: http://etcd:2379
      ETCDCTL_API: "3"
      ETCD_ROOT_PASSWORD: ${ETCD_TOKEN}
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data
      - storage  # Used by SeaweedFS filer for metadata

  milvus-standalone:
    container_name: milvus
    image: {{ global.registry_prefix }}{{ image_tags.milvus }}
    restart: always
    command: [ "milvus", "run", "standalone" ]
    security_opt:
      - seccomp:unconfined
    environment:
      # Etcd Configuration (dots in YAML become underscores in env vars)
      ETCD_ENDPOINTS: {{ ETCD_ENDPOINTS }}
      ETCD_ROOTPATH: milvus
      ETCD_AUTH_USERNAME: root
      ETCD_AUTH_PASSWORD: ${ETCD_TOKEN}
      # MinIO/S3 Storage Configuration
      MINIO_ADDRESS: {{ SEAWEEDFS_S3_ENDPOINT }}
      MINIO_ACCESS_KEY_ID: ${S3_STORAGE_ACCESS_KEY}
      MINIO_SECRET_ACCESS_KEY: ${S3_STORAGE_SECRET_KEY}
      # Token-based authentication - root password for Milvus
      COMMON_SECURITY_DEFAULTROOTPASSWORD: ${MILVUS_ROOT_PASSWORD}
    volumes:
      - {{ global.volume_root }}/milvus-data:/var/lib/milvus
      - ./configs/milvus/milvus-config.{{ stage_postfix }}.yml:/milvus/configs/milvus.yaml
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:9091/healthz" ]
      start_period: 90s
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "19530:19530"
      - "9091:9091"
    {%- endif %}
    depends_on:
      etcd-init:
        condition: service_completed_successfully
      seaweedfs-s3:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data
      - storage  # For S3 access to SeaweedFS

  attu:
    container_name: attu
    image: {{ global.registry_prefix }}{{ image_tags.attu }}
    restart: always
    depends_on:
      - milvus-standalone
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "3003:3000"
    {%- endif %}
    environment:
      MILVUS_URL: {{ MILVUS_HOST }}:{{ MILVUS_PORT }}
      # Milvus authentication credentials (root username is hardcoded in Milvus)
      ATTU_LOGIN_USERNAME: root
      ATTU_LOGIN_PASSWORD: ${MILVUS_ROOT_PASSWORD}
    healthcheck:
      test: ["NONE"]
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data

  {% if stage != 'dev' -%}
  oauth2proxy-attu:
    container_name: oauth2proxy-attu
    image: {{ image_tags.oauth2proxy }}
    restart: always
    environment:
      OAUTH2_PROXY_HTTP_ADDRESS: 0.0.0.0:4182
      OAUTH2_PROXY_COOKIE_SECURE: False
      OAUTH2_PROXY_CODE_CHALLENGE_METHOD: S256
      OAUTH2_PROXY_UPSTREAMS: http://attu:3000
      OAUTH2_PROXY_ALLOWED_GROUPS: ${OAUTH_ALLOWED_GROUPS_ATTU}
      OAUTH2_PROXY_OIDC_GROUPS_CLAIM: roles
      OAUTH2_PROXY_SCOPE: openid email profile roles
      OAUTH2_PROXY_CLIENT_ID: oauth2-proxy-attu
      OAUTH2_PROXY_PROVIDER: oidc
      OAUTH2_PROXY_PROVIDER_DISPLAY_NAME: ${OAUTH_PROVIDER_NAME}
      OAUTH2_PROXY_SKIP_OIDC_DISCOVERY: "true"
      OAUTH2_PROXY_OIDC_ISSUER_URL: https://auth.${DOMAIN}/realms/{{ KEYCLOAK_REALM }}
      OAUTH2_PROXY_LOGIN_URL: https://auth.${DOMAIN}/realms/{{ KEYCLOAK_REALM }}/protocol/openid-connect/auth
      OAUTH2_PROXY_REDEEM_URL: {{ KEYCLOAK_INTERNAL_URL }}/realms/{{ KEYCLOAK_REALM }}/protocol/openid-connect/token
      OAUTH2_PROXY_OIDC_JWKS_URL: {{ KEYCLOAK_INTERNAL_URL }}/realms/{{ KEYCLOAK_REALM }}/protocol/openid-connect/certs
      OAUTH2_PROXY_COOKIE_SECRET: ${OAUTH_COOKIE_SECRET_ATTU}
      OAUTH2_PROXY_CLIENT_SECRET: ${KEYCLOAK_OAUTH2_PROXY_ATTU_SECRET}
      OAUTH2_PROXY_EMAIL_DOMAINS: "*"
      OAUTH2_PROXY_CUSTOM_SIGN_IN_LOGO: ${OAUTH_CUSTOM_SIGN_IN_LOGO}
      OAUTH2_PROXY_REVERSE_PROXY: True
      OAUTH2_PROXY_REDIRECT_URL: https://attu.${DOMAIN}
    depends_on:
      - attu
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      - "traefik.http.routers.attu.rule=Host(`attu.${DOMAIN}`)"
      - "traefik.http.routers.attu.priority=4000"
      - "traefik.http.routers.attu.entrypoints=websecure"
      {%- if stage not in ['local', 'build'] %}
      - "traefik.http.routers.attu.tls.certresolver=letsencrypt"
      {%- else %}
      - "traefik.http.routers.attu.tls=true"
      {%- endif %}
      - "traefik.http.routers.attu.middlewares=security-headers@file"
      - "traefik.http.services.attu.loadbalancer.server.port=4182"
    networks:
      - proxy
      - data
  {% endif %}

  # ===================================================================
  # Postgres Stack (SQL Database)
  # ===================================================================
  # PostgreSQL instance for application relational data.
  # ===================================================================

  postgres:
    container_name: postgres
    image: {{ global.registry_prefix }}{{ image_tags.postgres }}
    restart: always
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_MULTIPLE_DATABASES: openwebui,langfuse,dagster,litellm,keycloak
    volumes:
      - {{ global.volume_root }}/postgres-data:/var/lib/postgresql/data
      - ./configs/postgres/init-multiple-dbs.sh:/docker-entrypoint-initdb.d/init-multiple-dbs.sh:ro
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "5432:5432"
    {%- endif %}
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U ${POSTGRES_USER}" ]
      start_period: 5s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data

  {% if stage != 'dev' %}
  # ===================================================================
  # PgBouncer (Connection Pooler for Dagster)
  # ===================================================================
  pgbouncer:
    container_name: pgbouncer
    image: {{ global.registry_prefix }}{{ image_tags.pgbouncer }}
    restart: always
    environment:
      DB_HOST: postgres
      DB_PORT: "5432"
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: dagster
      AUTH_TYPE: scram-sha-256
      POOL_MODE: transaction
      MAX_CLIENT_CONN: "${PGBOUNCER_MAX_CLIENT_CONN:-1000}"
      DEFAULT_POOL_SIZE: "${PGBOUNCER_DEFAULT_POOL_SIZE:-20}"
      MIN_POOL_SIZE: "${PGBOUNCER_MIN_POOL_SIZE:-2}"
      RESERVE_POOL_SIZE: "${PGBOUNCER_RESERVE_POOL_SIZE:-3}"
      LISTEN_ADDR: "0.0.0.0"
      LISTEN_PORT: "6432"
      ADMIN_USERS: ${POSTGRES_USER}
      LOG_CONNECTIONS: "0"
      LOG_DISCONNECTIONS: "0"
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: [ "CMD", "pg_isready", "-h", "127.0.0.1", "-p", "6432", "-U", "${POSTGRES_USER}" ]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 5s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data
  {% endif %}

  # ===================================================================
  # FerretDB Stack (MongoDB Compatibility)
  # ===================================================================
  # FerretDB provides MongoDB-compatible API backed by PostgreSQL.
  # ===================================================================

  postgres-ferretdb:
    container_name: postgres-ferretdb
    image: {{ global.registry_prefix }}{{ image_tags.postgres_ferretdb }}
    restart: always
    environment:
      POSTGRES_USER: ${MONGO_USERNAME}
      POSTGRES_PASSWORD: ${MONGO_PASSWORD}
      POSTGRES_DB: postgres
    volumes:
      - {{ global.volume_root }}/ferretdb-postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${MONGO_USERNAME} -d postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data

  ferretdb:
    container_name: ferretdb
    image: {{ global.registry_prefix }}{{ image_tags.ferretdb }}
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "27017:27017"
    {%- endif %}
    environment:
      - FERRETDB_POSTGRESQL_URL=postgres://${MONGO_USERNAME}:${MONGO_PASSWORD}@postgres-ferretdb:5432/postgres
    depends_on:
      postgres-ferretdb:
        condition: service_healthy
    healthcheck:
      test: [ "NONE" ]
    labels:
      healthcheck.enabled: "true"
      healthcheck.protocol: "http"
      healthcheck.port: "8088"
      healthcheck.path: "/debug/livez"
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data

  # ===================================================================
  # Neo4j Stack (Graph Database)
  # ===================================================================
  # Neo4j provides graph database capabilities for relationship-based
  # data modeling and querying.
  # ===================================================================

  neo4j:
    container_name: neo4j
    image: {{ global.registry_prefix }}{{ image_tags.neo4j }}
    restart: always
    {%- if stage == 'dev' %}
    ports:
      - "7474:7474"
      - "7687:7687"
    {%- endif %}
    volumes:
      - {{ global.volume_root }}/neo4j/logs:/logs
      - {{ global.volume_root }}/neo4j/config:/config
      - {{ global.volume_root }}/neo4j/data:/data
      - {{ global.volume_root }}/neo4j/plugins:/plugins
    environment:
      NEO4J_AUTH: ${NEO4J_USERNAME}/${NEO4J_PASSWORD}
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:7474"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 40s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data  # Graph database for Mem0 memory storage

  # ===================================================================
  # Langfuse Stack (LLM Observability & Evaluation)
  # ===================================================================
  # Langfuse provides tracing, evaluation, and observability for LLM apps.
  # Open-source alternative with MIT license for self-hosted deployments.
  # ===================================================================

  clickhouse:
    container_name: clickhouse
    image: {{ global.registry_prefix }}{{ image_tags.clickhouse }}
    restart: always
    environment:
      CLICKHOUSE_DB: default
      CLICKHOUSE_USER: "clickhouse"
      CLICKHOUSE_PASSWORD: ${LANGFUSE_CLICKHOUSE_PASSWORD}
    volumes:
    {%- if stage == 'dev' %}
      # Named volumes avoid Windows bind-mount issues with ClickHouse atomic renames
      - clickhouse-data:/var/lib/clickhouse
      - clickhouse-logs:/var/log/clickhouse-server
    {%- else %}
      - {{ global.volume_root }}/clickhouse-data:/var/lib/clickhouse
      - {{ global.volume_root }}/clickhouse-logs:/var/log/clickhouse-server
    {%- endif %}
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "127.0.0.1:8123:8123"
      - "127.0.0.1:9009:9000"
    {%- endif %}
    healthcheck:
      test: wget --no-verbose --tries=1 --spider http://localhost:8123/ping || exit 1
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 1s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data

  langfuse-worker:
    container_name: langfuse-worker
    image: {{ global.registry_prefix }}{{ image_tags.langfuse_worker }}
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_started
      clickhouse:
        condition: service_healthy
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "127.0.0.1:3030:3030"
    {%- endif %}
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/langfuse
      SALT: ${LANGFUSE_SALT}
      ENCRYPTION_KEY: ${LANGFUSE_ENCRYPTION_KEY}
      TELEMETRY_ENABLED: "false"
      LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES: "true"
      CLICKHOUSE_MIGRATION_URL: clickhouse://clickhouse:9000
      CLICKHOUSE_URL: http://clickhouse:8123
      CLICKHOUSE_USER: "clickhouse"
      CLICKHOUSE_PASSWORD: ${LANGFUSE_CLICKHOUSE_PASSWORD}
      CLICKHOUSE_CLUSTER_ENABLED: "false"
      # Use SeaweedFS for S3-compatible storage
      LANGFUSE_S3_EVENT_UPLOAD_BUCKET: langfuse
      LANGFUSE_S3_EVENT_UPLOAD_REGION: auto
      LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID: ${S3_STORAGE_ACCESS_KEY}
      LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY: ${S3_STORAGE_SECRET_KEY}
      LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT: {{ S3_STORAGE_ENDPOINT }}
      LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE: "true"
      LANGFUSE_S3_EVENT_UPLOAD_PREFIX: events/
      LANGFUSE_S3_MEDIA_UPLOAD_BUCKET: langfuse
      LANGFUSE_S3_MEDIA_UPLOAD_REGION: auto
      LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID: ${S3_STORAGE_ACCESS_KEY}
      LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY: ${S3_STORAGE_SECRET_KEY}
      LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT: {{ S3_STORAGE_ENDPOINT }}
      LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE: "true"
      LANGFUSE_S3_MEDIA_UPLOAD_PREFIX: media/
      LANGFUSE_S3_BATCH_EXPORT_ENABLED: "false"
      REDIS_HOST: valkey
      REDIS_PORT: 6379
      REDIS_AUTH: ${REDIS_TOKEN}
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - backend
      - data  # For PostgreSQL access
      - storage  # For SeaweedFS S3 access

  langfuse-web:
    container_name: langfuse-web
    image: {{ global.registry_prefix }}{{ image_tags.langfuse_web }}
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_started
      clickhouse:
        condition: service_healthy
      langfuse-worker:
        condition: service_started
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "6006:3000"
    {%- endif %}
    environment:
      HOSTNAME: "0.0.0.0"
      NEXTAUTH_URL: ${LANGFUSE_NEXTAUTH_URL}
      NEXTAUTH_SECRET: ${LANGFUSE_NEXTAUTH_SECRET}
      DATABASE_URL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/langfuse
      SALT: ${LANGFUSE_SALT}
      ENCRYPTION_KEY: ${LANGFUSE_ENCRYPTION_KEY}
      TELEMETRY_ENABLED: "false"
      LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES: "true"
      CLICKHOUSE_MIGRATION_URL: clickhouse://clickhouse:9000
      CLICKHOUSE_URL: http://clickhouse:8123
      CLICKHOUSE_USER: "clickhouse"
      CLICKHOUSE_PASSWORD: ${LANGFUSE_CLICKHOUSE_PASSWORD}
      CLICKHOUSE_CLUSTER_ENABLED: "false"
      # Use SeaweedFS for S3-compatible storage
      LANGFUSE_S3_EVENT_UPLOAD_BUCKET: langfuse
      LANGFUSE_S3_EVENT_UPLOAD_REGION: auto
      LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID: ${S3_STORAGE_ACCESS_KEY}
      LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY: ${S3_STORAGE_SECRET_KEY}
      LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT: {{ S3_STORAGE_ENDPOINT }}
      LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE: "true"
      LANGFUSE_S3_EVENT_UPLOAD_PREFIX: events/
      LANGFUSE_S3_MEDIA_UPLOAD_BUCKET: langfuse
      LANGFUSE_S3_MEDIA_UPLOAD_REGION: auto
      LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID: ${S3_STORAGE_ACCESS_KEY}
      LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY: ${S3_STORAGE_SECRET_KEY}
      LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT: {{ S3_STORAGE_ENDPOINT }}
      LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE: "true"
      LANGFUSE_S3_MEDIA_UPLOAD_PREFIX: media/
      LANGFUSE_S3_BATCH_EXPORT_ENABLED: "false"
      REDIS_HOST: valkey
      REDIS_PORT: 6379
      REDIS_AUTH: ${REDIS_TOKEN}
      # Auto-initialize default project for API access
      LANGFUSE_INIT_ORG_ID: "aihub-org"
      LANGFUSE_INIT_ORG_NAME: "AI-Hub"
      LANGFUSE_INIT_PROJECT_ID: "aihub-project"
      LANGFUSE_INIT_PROJECT_NAME: "AI-Hub"
      LANGFUSE_INIT_PROJECT_PUBLIC_KEY: ${LANGFUSE_PUBLIC_KEY}
      LANGFUSE_INIT_PROJECT_SECRET_KEY: ${LANGFUSE_SECRET_KEY}
      LANGFUSE_INIT_USER_EMAIL: ${LANGFUSE_INIT_USER_EMAIL}
      LANGFUSE_INIT_USER_NAME: "AI-Hub Admin"
      LANGFUSE_INIT_USER_PASSWORD: ${LANGFUSE_INIT_USER_PASSWORD}
      # Azure AD SSO — dedicated app registration with "assignment required"
      AUTH_AZURE_AD_CLIENT_ID: ${LANGFUSE_AZURE_AD_CLIENT_ID}
      AUTH_AZURE_AD_CLIENT_SECRET: ${LANGFUSE_AZURE_AD_CLIENT_SECRET}
      AUTH_AZURE_AD_TENANT_ID: ${LANGFUSE_AZURE_AD_TENANT_ID}
      AUTH_AZURE_AD_ALLOW_ACCOUNT_LINKING: "true"
      # Auto-provisioning — assigned SSO users get MEMBER in the AI-Hub org/project
      LANGFUSE_DEFAULT_ORG_ID: "aihub-org"
      LANGFUSE_DEFAULT_ORG_ROLE: "MEMBER"
      LANGFUSE_DEFAULT_PROJECT_ID: "aihub-project"
      LANGFUSE_DEFAULT_PROJECT_ROLE: "MEMBER"
      # Auth controls
      AUTH_DISABLE_USERNAME_PASSWORD: "{{ 'true' if stage in ['nightly', 'latest'] else 'false' }}"
      AUTH_DISABLE_SIGNUP: "false"
      LANGFUSE_ALLOWED_ORGANIZATION_CREATORS: ${LANGFUSE_ALLOWED_ORGANIZATION_CREATORS}
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://$(hostname):3000/api/public/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    {%- if stage != 'dev' %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.langfuse.rule=Host(`langfuse.${DOMAIN}`)"
      - "traefik.http.routers.langfuse.priority=4000"
      - "traefik.http.routers.langfuse.entrypoints=websecure"
      - "traefik.http.routers.langfuse.middlewares=security-headers@file"
      - "traefik.http.services.langfuse.loadbalancer.server.port=3000"
      {%- if stage not in ['local', 'build'] %}
      - "traefik.http.routers.langfuse.tls.certresolver=letsencrypt"
      {%- else %}
      - "traefik.http.routers.langfuse.tls=true"
      {%- endif %}
    {%- endif %}
    networks:
      - backend
      - data  # For PostgreSQL access
      - storage  # For SeaweedFS S3 access
      {%- if stage != 'dev' %}
      - proxy  # For Traefik access
      {%- endif %}

  # ===================================================================
  # Keycloak Stack (Identity and Access Management)
  # ===================================================================
  # Keycloak provides OIDC/OAuth2 authentication for all services.
  # In dev: Local users for development and E2E testing.
  # In prod: Identity broker for Azure AD and other providers.
  # ===================================================================

  keycloak:
    container_name: keycloak
    image: quay.io/keycloak/{{ image_tags.keycloak }}
    restart: unless-stopped
    {%- if stage == 'dev' %}
    ports:
      - "8180:8080"
    command:
      - start-dev
      - --import-realm
    {%- else %}
    # Shell wrapper to substitute ${DOMAIN} in realm JSON before import.
    # Keycloak's --import-realm does not support env var substitution natively,
    # so we pre-process the template files with sed before starting.
    #
    # Import strategy:
    # - aihub-realm.json: Imported via --import-realm (creates realm on first start only)
    # - identity-providers.json: Applied via partialImport API after startup (every start,
    #   with OVERWRITE so config changes are picked up). This keeps the files separate
    #   and avoids --import-realm's OVERWRITE_EXISTING destroying the realm.
    entrypoint: /bin/bash
    command:
      - -c
      - |
        mkdir -p /opt/keycloak/data/import
        # Substitute all environment variables in template files.
        # Keycloak's --import-realm does not support env var substitution, so we
        # use a pure-bash envsubst (the Keycloak image has no envsubst/perl/awk).
        bash_envsubst() {
          local content
          content=$$(cat "$$1")
          while IFS= read -r var; do
            content=$${content//"\$${$$var}"/"$${!var}"}
          done < <(compgen -v)
          echo "$$content"
        }
        for f in /opt/keycloak/data/import-templates/*.json; do
          bash_envsubst "$$f" > "/tmp/$$(basename $$f)"
        done
        # Only the realm file goes to --import-realm (first-start creation)
        cp /tmp/aihub-realm.json /opt/keycloak/data/import/
        # Apply identity providers via partialImport after Keycloak is ready
        if [ -f /tmp/identity-providers.json ]; then
          (
            echo "Waiting for Keycloak to be ready before applying identity providers..."
            until /opt/keycloak/bin/kcadm.sh config credentials --server http://localhost:8080 --realm master --user "$$KC_BOOTSTRAP_ADMIN_USERNAME" --password "$$KC_BOOTSTRAP_ADMIN_PASSWORD" > /dev/null 2>&1; do sleep 3; done
            /opt/keycloak/bin/kcadm.sh create partialImport -r aihub \
              -s ifResourceExists=OVERWRITE \
              -f /tmp/identity-providers.json \
              && echo "Identity providers applied successfully." \
              || echo "ERROR: Failed to apply identity providers."
          ) &
        fi
        exec /opt/keycloak/bin/kc.sh start --import-realm --hostname=https://auth.$$DOMAIN --hostname-backchannel-dynamic=true --proxy-headers=xforwarded --http-enabled=true
    {%- endif %}
    environment:
      KC_DB: postgres
      KC_DB_URL: jdbc:postgresql://postgres:5432/keycloak
      KC_DB_USERNAME: ${POSTGRES_USER}
      KC_DB_PASSWORD: ${POSTGRES_PASSWORD}
      KC_BOOTSTRAP_ADMIN_USERNAME: ${KEYCLOAK_ADMIN_USER}
      KC_BOOTSTRAP_ADMIN_PASSWORD: ${KEYCLOAK_ADMIN_PASSWORD}
      KC_FEATURES: token-exchange,admin-fine-grained-authz
      KC_HEALTH_ENABLED: "true"
      KC_METRICS_ENABLED: "true"
      {%- if stage != 'dev' %}
      DOMAIN: ${DOMAIN}
      {%- endif %}
      # Dev user configuration (passed to realm template)
      KEYCLOAK_DEV_USER_USERNAME: ${KEYCLOAK_DEV_USER_USERNAME}
      KEYCLOAK_DEV_USER_PASSWORD: ${KEYCLOAK_DEV_USER_PASSWORD}
      KEYCLOAK_DEV_USER_EMAIL: ${KEYCLOAK_DEV_USER_EMAIL}
      KEYCLOAK_DEV_USER_FIRSTNAME: ${KEYCLOAK_DEV_USER_FIRSTNAME}
      KEYCLOAK_DEV_USER_LASTNAME: ${KEYCLOAK_DEV_USER_LASTNAME}
      KEYCLOAK_DEV_USER_ROLES_JSON: ${KEYCLOAK_DEV_USER_ROLES_JSON}
      # Client secrets (used by bash_envsubst in realm template)
      KEYCLOAK_OPENWEBUI_CLIENT_SECRET: ${KEYCLOAK_OPENWEBUI_CLIENT_SECRET}
      KEYCLOAK_OAUTH2_PROXY_DAGSTER_SECRET: ${KEYCLOAK_OAUTH2_PROXY_DAGSTER_SECRET}
      KEYCLOAK_OAUTH2_PROXY_DATALAKE_SECRET: ${KEYCLOAK_OAUTH2_PROXY_DATALAKE_SECRET}
      KEYCLOAK_OAUTH2_PROXY_ATTU_SECRET: ${KEYCLOAK_OAUTH2_PROXY_ATTU_SECRET}
      # Azure Entra ID configuration (for identity provider federation)
      KEYCLOAK_AZURE_CLIENT_ID: ${KEYCLOAK_AZURE_CLIENT_ID}
      KEYCLOAK_AZURE_CLIENT_SECRET: ${KEYCLOAK_AZURE_CLIENT_SECRET}
      KEYCLOAK_AZURE_TENANT_ID: ${KEYCLOAK_AZURE_TENANT_ID}
    volumes:
      {%- if stage == 'dev' %}
      # Dev stage: mount directly (no ${DOMAIN} substitution needed)
      - ./configs/keycloak/aihub-realm.{{ stage_postfix }}.json:/opt/keycloak/data/import/aihub-realm.json:ro
      - ./configs/keycloak/identity-providers.{{ stage_postfix }}.json:/opt/keycloak/data/import/identity-providers.json:ro
      {%- else %}
      # Non-dev stages: mount as templates, sed-processed before import
      - ./configs/keycloak/aihub-realm.{{ stage_postfix }}.json:/opt/keycloak/data/import-templates/aihub-realm.json:ro
      - ./configs/keycloak/identity-providers.{{ stage_postfix }}.json:/opt/keycloak/data/import-templates/identity-providers.json:ro
      {%- endif %}
    healthcheck:
      test: ["CMD-SHELL", "exec 3<>/dev/tcp/127.0.0.1/9000;echo -e 'GET /health/ready HTTP/1.1\r\nhost: localhost\r\nConnection: close\r\n\r\n' >&3;grep -q '200 OK' <&3"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    depends_on:
      postgres:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    {%- if stage != 'dev' %}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      - "traefik.http.routers.keycloak.rule=Host(`auth.${DOMAIN}`)"
      - "traefik.http.routers.keycloak.entrypoints=websecure"
      - "traefik.http.routers.keycloak.tls=true"
      {%- if stage in ['nightly', 'latest'] %}
      - "traefik.http.routers.keycloak.tls.certresolver=letsencrypt"
      {%- endif %}
      - "traefik.http.routers.keycloak.priority=7000"
      - "traefik.http.routers.keycloak.middlewares=keycloak-security-headers"
      - "traefik.http.services.keycloak.loadbalancer.server.port=8080"
      # Keycloak manages its own X-Frame-Options per realm (master: SAMEORIGIN
      # for admin console session iframes, aihub: empty for parent app embedding).
      # We only add non-frame security headers here to avoid overriding Keycloak's
      # native per-realm frame policy — DENY breaks the admin console.
      - "traefik.http.middlewares.keycloak-security-headers.headers.sslRedirect=false"
      - "traefik.http.middlewares.keycloak-security-headers.headers.stsSeconds=31536000"
      - "traefik.http.middlewares.keycloak-security-headers.headers.stsIncludeSubdomains=true"
      - "traefik.http.middlewares.keycloak-security-headers.headers.contentTypeNosniff=true"
      - "traefik.http.middlewares.keycloak-security-headers.headers.browserXssFilter=true"
      - "traefik.http.middlewares.keycloak-security-headers.headers.referrerPolicy=strict-origin-when-cross-origin"
    {%- endif %}
    networks:
      - data   # PostgreSQL access for Keycloak database
      {%- if stage != 'dev' %}
      - proxy  # Traefik routing for auth.${DOMAIN}
      {%- endif %}

  # ===================================================================
  # Nats & Valkey Stack (Messaging and Caching)
  # ===================================================================
  # Nats provides the messaging bus for asynchronous communication
  # between agents, and Valkey provides in-memory caching.
  # ===================================================================

  nats:
    container_name: nats
    image: {{ global.registry_prefix }}{{ image_tags.nats }}
    restart: always
    command: -c /etc/nats/nats-server.conf
    environment:
      # Token-based authentication for NATS clients
      NATS_TOKEN: ${NATS_TOKEN}
    volumes:
      - ./configs/nats/nats-config.{{ stage_postfix }}.conf:/etc/nats/nats-server.conf
      - {{ global.volume_root }}/nats:/data/nats
    healthcheck:
      test: [ "NONE" ]
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "4222:4222"
      - "8222:8222"
    {%- endif %}
    labels:
      healthcheck.enabled: "true"
      healthcheck.protocol: "http"
      healthcheck.port: "8222"
      healthcheck.path: "/healthz"
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data  # Message broker is part of data infrastructure

  valkey:
    container_name: valkey
    image: {{ global.registry_prefix }}{{ image_tags.valkey }}
    restart: always
    # Password authentication enabled via --requirepass
    command: valkey-server --save 30 1 --loglevel warning --requirepass ${REDIS_TOKEN}
    volumes:
      - {{ global.volume_root }}/valkey-data:/data
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "6379:6379"
    {%- endif %}
    healthcheck:
      # Use REDISCLI_AUTH to authenticate for health check
      test: [ "CMD-SHELL", "REDISCLI_AUTH=${REDIS_TOKEN} valkey-cli ping" ]
      start_period: 5s
    environment:
      REDIS_TOKEN: ${REDIS_TOKEN}
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data  # Cache is part of data infrastructure

  # ===================================================================
  # Rclone (Universal Cloud Storage Sync)
  # ===================================================================
  # Provides RC API for syncing files from 70+ cloud providers
  # (OneDrive, SharePoint, S3, Google Drive, Dropbox, etc.)
  # ===================================================================

  rclone:
    container_name: rclone
    image: {{ image_tags.rclone }}
    restart: unless-stopped
    command:
      - "rcd"
      - "--rc-addr=0.0.0.0:5572"
      - "--rc-serve"
      {%- if stage == 'dev' %}
      - "--rc-no-auth"  # Only in dev!
      {%- else %}
      - "--rc-user=${RCLONE_RC_USER}"
      - "--rc-pass=${RCLONE_RC_PASS}"
      {%- endif %}
      - "--log-level=INFO"
      - "--config=/dev/null"  # Disable config file, use environment variables only
    {%- if stage == 'dev' %}
    ports:
      - "5572:5572"
    {%- endif %}
    networks:
      - default
    healthcheck:
      {%- if stage == 'dev' %}
      test: ["CMD", "rclone", "rc", "--rc-addr=localhost:5572", "core/version"]
      {%- else %}
      test: ["CMD", "rclone", "rc", "--rc-addr=localhost:5572", "--rc-user=${RCLONE_RC_USER}", "--rc-pass=${RCLONE_RC_PASS}", "core/version"]
      {%- endif %}
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2

  {%- if (gpu_enabled and stage in ['nightly', 'latest']) or stage == 'dev' %}
  # ===================================================================
  # AI Model Serving (Local Inference)
  # ===================================================================
  # GPU variants are only used for 'nightly' and 'latest' stages when
  # GPU is enabled. All other configurations use CPU variants.
  # ===================================================================

  {%- set llama_cpp_use_gpu = gpu_enabled and stage in ['nightly', 'latest'] %}
  llama-cpp:
    container_name: llama-cpp
    platform: "linux/amd64"
    image: {{ global.registry_prefix }}{{ image_tags.llama_cpp_gpu if llama_cpp_use_gpu else image_tags.llama_cpp_cpu }}
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "8182:8182"
    {%- endif %}
    volumes:
      - {{ global.volume_root }}/llamacpp-data:/data
      - {{ global.volume_root }}/huggingface:/root/.cache/huggingface
      - {{ global.volume_root }}/llamacpp-cache:/root/.cache/llama.cpp
    environment:
      HF_HOME: /root/.cache/huggingface
      LLAMA_API_KEY: ${LOCAL_LLM_TOKEN}
    command: >
      {%- if llama_cpp_use_gpu %}
      -hf google/gemma-3-12b-it-qat-q4_0-gguf
      --alias gemma-3-12b
      -ngl -1
      {%- else %}
      -hf google/gemma-3-4b-it-qat-q4_0-gguf
      --alias gemma-3-4b
      {%- endif %}
      --port 8182
      --hf-token ${HUGGINGFACE_API_KEY}
      --host 0.0.0.0
      -c 8196
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:8182/health" ]
      timeout: 10s
      interval: 30s
      retries: 3
      start_period: 120s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    {%- if llama_cpp_use_gpu %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: [ '0' ]
              capabilities: [ gpu ]
    {%- endif %}
    networks:
      - backend

  llama-cpp-embedding:
    container_name: llama-cpp-embedding
    platform: "linux/amd64"
    image: {{ global.registry_prefix }}{{ image_tags.llama_cpp_gpu if llama_cpp_use_gpu else image_tags.llama_cpp_cpu }}
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "8183:8182"
    {%- endif %}
    volumes:
      - {{ global.volume_root }}/llamacpp-data:/data
      - {{ global.volume_root }}/huggingface:/root/.cache/huggingface
      - {{ global.volume_root }}/llamacpp-cache:/root/.cache/llama.cpp
    environment:
      HF_HOME: /root/.cache/huggingface
      LLAMA_API_KEY: ${LOCAL_LLM_TOKEN}
    command: >
      -hf Qwen/Qwen3-Embedding-0.6B-GGUF
      --hf-token ${HUGGINGFACE_API_KEY}
      --alias qwen-3-embedding
      --port 8182
      --host 0.0.0.0
      --embedding
      --pooling last
      -ub 8192
      {%- if llama_cpp_use_gpu %}
      -ngl -1
      {%- endif %}
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:8182/health" ]
      timeout: 10s
      interval: 30s
      retries: 3
      start_period: 60s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    {%- if llama_cpp_use_gpu %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: [ '0' ]
              capabilities: [ gpu ]
    {%- endif %}
    networks:
      - backend

  llama-cpp-reranker:
    container_name: llama-cpp-reranker
    platform: "linux/amd64"
    image: {{ global.registry_prefix }}{{ image_tags.llama_cpp_gpu if llama_cpp_use_gpu else image_tags.llama_cpp_cpu }}
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "8184:8182"
    {%- endif %}
    volumes:
      - {{ global.volume_root }}/llamacpp-data:/data
      - {{ global.volume_root }}/huggingface:/root/.cache/huggingface
      - {{ global.volume_root }}/llamacpp-cache:/root/.cache/llama.cpp
    environment:
      HF_HOME: /root/.cache/huggingface
      LLAMA_API_KEY: ${LOCAL_LLM_TOKEN}
    command: >
      -hf ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF
      --hf-token ${HUGGINGFACE_API_KEY}
      --alias qwen-3-reranking
      --port 8182
      --host 0.0.0.0
      -c 8192
      --reranking
      --no-context-shift
      {%- if llama_cpp_use_gpu %}
      -ngl 10
      {%- endif %}
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:8182/health" ]
      timeout: 10s
      interval: 30s
      retries: 3
      start_period: 60s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    {%- if llama_cpp_use_gpu %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: [ '0' ]
              capabilities: [ gpu ]
    {%- endif %}
    networks:
      - backend

  # ===================================================================
  # Audio Model Serving (SST/TTS)
  # ===================================================================
  # We are using speaches to serve audio models in an openai
  # compatible format. GPU variants are only used for 'nightly' and
  # 'latest' stages when GPU is enabled.
  # ===================================================================

  {%- set speaches_use_gpu = gpu_enabled and stage in ['nightly', 'latest'] %}
  speaches:
    container_name: speaches
    image: {{ global.registry_prefix }}{{ image_tags.speaches_gpu if speaches_use_gpu else image_tags.speaches_cpu }}
    restart: unless-stopped
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "8185:8000"
    {%- endif %}
    volumes:
      - {{ global.volume_root }}/huggingface:/root/.cache/huggingface
    environment:
      HF_HOME: /root/.cache/huggingface
      HF_TOKEN: ${HUGGINGFACE_API_KEY}
      ENABLE_UI: False
    healthcheck:
      test: [ "CMD", "curl", "--fail", "http://0.0.0.0:8000/health" ]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 5s
    {%- if speaches_use_gpu %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: [ '0' ]
              capabilities: [ gpu ]
    {%- endif %}
    networks:
      - backend
  {%- endif %}

  # ===================================================================
  # LiteLLM Stack (Model Proxy and Guardrails)
  # ===================================================================
  # This stack provides a unified interface to various LLMs,
  # handles PII filtering, and manages API keys.
  # ===================================================================

  presidio-analyzer:
    container_name: presidio-analyzer
    image: {{ global.registry_prefix }}{{ image_tags.presidio_analyzer }}
    restart: always
    labels:
      healthcheck.enabled: "true"
      healthcheck.protocol: "http"
      healthcheck.port: "3000"
      healthcheck.path: "/health"
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - backend

  presidio-anonymizer:
    container_name: presidio-anonymizer
    image: {{ global.registry_prefix }}{{ image_tags.presidio_anonymizer }}
    restart: always
    labels:
      healthcheck.enabled: "true"
      healthcheck.protocol: "http"
      healthcheck.port: "3000"
      healthcheck.path: "/health"
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - backend

  litellm:
    container_name: litellm
    image: {{ global.registry_prefix }}{{ image_tags.litellm }}
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "4000:4000"
    {%- endif %}
    environment:
      DATABASE_URL: "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/litellm"
      LITELLM_MASTER_KEY: ${LITELLM_MASTER_KEY}
      UI_USERNAME: ${LITELLM_UI_USERNAME}
      UI_PASSWORD: ${LITELLM_UI_PASSWORD}
      LOCAL_LLM_TOKEN: ${LOCAL_LLM_TOKEN}
      REDIS_TOKEN: ${REDIS_TOKEN}
      AZURE_OPENAI_BASE_URL: ${AZURE_OPENAI_BASE_URL}
      AZURE_OPENAI_KEY: ${AZURE_OPENAI_KEY}
      SWISS_LLM_CLOUD_API_BASE_URL: ${SWISS_LLM_CLOUD_API_BASE_URL}
      SWISS_LLM_CLOUD_API_KEY: ${SWISS_LLM_CLOUD_API_KEY}
      COHERE_API_BASE: ${COHERE_API_BASE}
      COHERE_API_KEY: ${COHERE_API_KEY}
      GEMINI_API_KEY: ${GEMINI_API_KEY}
      HUGGINGFACE_API_KEY: ${HUGGINGFACE_API_KEY}
      PRESIDIO_ANALYZER_API_BASE: {{ PRESIDIO_ANALYZER_API_BASE }}
      PRESIDIO_ANONYMIZER_API_BASE: {{ PRESIDIO_ANONYMIZER_API_BASE }}
      OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector:4317
      OTEL_EXPORTER_OTLP_PROTOCOL: grpc
      SET_VERBOSE: False
    volumes:
      - ./configs/litellm/litellm-config.{{ stage_postfix }}.yml:/app/config.yml
    command: --config /app/config.yml
    depends_on:
      postgres:
        condition: service_healthy
      presidio-analyzer:
        condition: service_started
      presidio-anonymizer:
        condition: service_started
    healthcheck:
      test: [ "CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:4000/health/liveliness')" ]
      timeout: 10s
      interval: 30s
      retries: 3
      start_period: 120s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    {%- if stage != 'dev' %}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      - "traefik.http.routers.litellm.rule=Host(`litellm.${DOMAIN}`)"
      - "traefik.http.routers.litellm.entrypoints=websecure"
      - "traefik.http.routers.litellm.middlewares=security-headers@file"
      - "traefik.http.services.litellm.loadbalancer.server.port=4000"
      {%- if stage not in ['local', 'build'] %}
      - "traefik.http.routers.litellm.tls.certresolver=letsencrypt"
      {%- else %}
      - "traefik.http.routers.litellm.tls=true"
      {%- endif %}
    {%- endif %}
    networks:
      - backend
      - data  # For PostgreSQL access
      {%- if stage != 'dev' %}
      - proxy  # For external API access via Traefik
      {%- endif %}

  # ===================================================================
  # Utility & Code Execution Services
  # ===================================================================
  # These services provide code execution runtimes (Jupyter) and
  # browser automation (Playwright) for various platform features.
  # ===================================================================

  jupyter:
    container_name: jupyter-lab
    image: {{ global.registry_prefix }}{{ image_tags.jupyter }}
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "8888:8888"
    {%- endif %}
    volumes:
      - {{ global.volume_root }}/jupyter-data:/home/jovyan/work
    environment:
      JUPYTER_ENABLE_LAB: yes
      JUPYTER_TOKEN: ${JUPYTER_TOKEN}
    healthcheck:
      test: ["CMD", "/etc/jupyter/docker_healthcheck.py"]
      interval: 15s
      timeout: 3s
      start_period: 10s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - backend

  playwright:
    container_name: playwright-server
    build:
      context: ./configs/playwright
      dockerfile: Dockerfile
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "3036:3000"
    {%- endif %}
    environment:
      NODE_ENV: production
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:3000/health" ]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - backend  # Internal service communication
      - egress   # Outbound internet access for web browsing

  # ===================================================================
  # Document Processing Stack
  # ===================================================================
  # This stack, powered by MinerU, handles OCR and parsing of
  # uploaded documents for the RAG pipeline. VLM requests are routed
  # through LiteLLM for unified model routing.
  # ===================================================================

  mineru-api:
    container_name: mineru-api
    image: {{ global.registry_prefix }}{{ image_tags.mineru_api }}
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "8002:8000"
    {%- endif %}
    environment:
      # VLM routing through LiteLLM (OpenAI-compatible)
      # Various API keys for OpenAI client compatibility
      OPENAI_API_KEY: ${LITELLM_MASTER_KEY}
      OPENAI_BASE_URL: {{ LITE_LLM_PROXY_BASE_URL }}/v1
      LITELLM_PROXY_API_KEY: ${LITELLM_MASTER_KEY}
      # MinerU-specific configuration (used by mineru_vl_utils HttpVlmClient)
      MINERU_VL_SERVER: {{ LITE_LLM_PROXY_BASE_URL }}/v1
      MINERU_VL_API_KEY: ${LITELLM_MASTER_KEY}
      MINERU_VL_MODEL_NAME: ${MINERU_VLM_NAME}
      # Processing configuration
      MINERU_API_MAX_CONCURRENT_REQUESTS: ${MINERU_API_MAX_CONCURRENT_REQUESTS}
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:8000/openapi.json" ]
      timeout: 10s
      interval: 30s
      retries: 3
      start_period: 60s
    depends_on:
      litellm:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    deploy:
      resources:
        limits:
          memory: 4G
    networks:
      - backend

  {%- if gpu_enabled %}
  mineru-vlm:
    container_name: mineru-vlm
    platform: "linux/amd64"
    image: {{ global.registry_prefix }}{{ image_tags.mineru_vlm }}
    restart: always
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "30000:30000"
    {%- endif %}
    # No volume mount - VLM models are baked into the image for faster startup
    environment:
      MINERU_MODEL_SOURCE: local
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:30000/health" ]
      timeout: 10s
      interval: 30s
      retries: 3
      start_period: 300s  # 5 minutes for model loading
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              device_ids: [ '0' ]
              capabilities: [ gpu ]
    networks:
      - backend
  {%- endif %}

  # ===================================================================
  # Observability Stack
  # ===================================================================
  # The OTEL Collector gathers traces, logs, and metrics for debugging
  # and monitoring. It is only enabled in the 'dev' stage.
  # ===================================================================

  otel-collector:
    container_name: otel-collector
    image: {{ image_tags.otel_collector }}
    restart: always
    command: [ "--config=/etc/otel-config.yml" ]
    environment:
      - OTEL_CLOUD_ENDPOINT=${OTEL_CLOUD_ENDPOINT}
      - OTEL_CLOUD_HEADERS=${OTEL_CLOUD_HEADERS}
      - LANGFUSE_PUBLIC_KEY=${LANGFUSE_PUBLIC_KEY}
      - LANGFUSE_SECRET_KEY=${LANGFUSE_SECRET_KEY}
    volumes:
      - ./configs/otel/otel-config.{{ stage_postfix }}.yml:/etc/otel-config.yml
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "4317:4317"
      - "4318:4318"
      - "13133:13133"
      - "55679:55679"
    {%- endif %}
    depends_on:
      - langfuse-web
    healthcheck:
      test: [ "NONE" ]
    labels:
      healthcheck.enabled: "true"
      healthcheck.protocol: "http"
      healthcheck.port: "13133"
      healthcheck.path: "/"
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - backend

  # ===================================================================
  # Open WebUI Stack (Primary User Interface)
  # ===================================================================
  # This is the main frontend application for the AI Hub. Its
  # configuration is the most complex, with many stage-specific
  # environment variables for connecting to other services.
  # ===================================================================

  open-webui:
    container_name: open-webui
    image: {{ global.registry_prefix }}{{ image_tags.open_webui }}
    restart: always
    {%- if stage == 'dev' %}
    network_mode: "host"
    {%- endif %}
    volumes:
      - {{ global.volume_root }}/open-webui:/app/backend/data
    depends_on:
      postgres:
        condition: service_healthy
      seaweedfs-s3:
        condition: service_healthy
      litellm:
        condition: service_started
      jupyter:
        condition: service_healthy
      playwright:
        condition: service_healthy
      keycloak:
        condition: service_healthy
      {%- if stage != 'dev' %}
      api:
        condition: service_healthy
      {%- endif %}
    environment:
      # --- General Settings ---
      WEBUI_NAME: Swiss AI-Hub
      DEFAULT_LOCALE: de
      # Disable model caching to ensure pipeline models (agents) are always fetched
      ENABLE_BASE_MODELS_CACHE: False
      ENABLE_COMMUNITY_SHARING: False
      ENABLE_USER_WEBHOOKS: False
      ENABLE_LOGIN_FORM: False
      ENABLE_FORWARD_USER_INFO_HEADERS: True
      ENABLE_VERSION_UPDATE_CHECK: False

      # --- Stage-Specific URLs and Environment ---
      {%- if stage == 'dev' %}
      WEBUI_URL: http://localhost:8080
      {%- else %}
      WEBUI_URL: https://openwebui.${DOMAIN}
      {%- endif %}
      ENV: ${ENV}
      GLOBAL_LOG_LEVEL: ${LOG_LEVEL}

      # --- Telemetry ---
      ENABLE_OTEL: True
      ENABLE_OTEL_METRICS: True
      OTEL_EXPORTER_OTLP_ENDPOINT: http://{{ 'localhost' if stage == 'dev' else 'otel-collector' }}:4317
      OTEL_EXPORTER_OTLP_PROTOCOL: grpc
      OTEL_EXPORTER_OTLP_INSECURE: True
      OTEL_SERVICE_NAME: open-webui

      # --- Auth & OIDC (Keycloak) ---
      WEBUI_SECRET_KEY: ${WEBUI_SECRET_KEY}
      WEBUI_AUTH: True
      DEFAULT_USER_ROLE: user
      OAUTH_MERGE_ACCOUNTS_BY_EMAIL: True
      ENABLE_API_KEY: False
      WEBUI_SESSION_COOKIE_SAME_SITE: lax
      WEBUI_SESSION_COOKIE_SECURE: {{ 'False' if stage == 'dev' else 'True' }}
      ENABLE_OAUTH_SIGNUP: True
      OAUTH_PROVIDER_NAME: ${OAUTH_PROVIDER_NAME}
      OAUTH_CLIENT_ID: openwebui
      OAUTH_CLIENT_SECRET: ${KEYCLOAK_OPENWEBUI_CLIENT_SECRET}
      OPENID_PROVIDER_URL: {{ KEYCLOAK_INTERNAL_URL }}/realms/{{ KEYCLOAK_REALM }}/.well-known/openid-configuration
      {%- if stage == 'dev' %}
      OPENID_REDIRECT_URI: http://localhost:8080/oauth/oidc/callback
      {%- else %}
      OPENID_REDIRECT_URI: https://openwebui.${DOMAIN}/oauth/oidc/callback
      {%- endif %}
      OAUTH_ALLOWED_DOMAINS: '*'
      OAUTH_SCOPES: openid email profile
      OAUTH_TIMEOUT: 60
      OAUTH_CODE_CHALLENGE_METHOD: S256
      OAUTH_USERNAME_CLAIM: preferred_username
      OAUTH_PICTURE_CLAIM: picture
      OAUTH_EMAIL_CLAIM: email
      OAUTH_GROUP_CLAIM: roles

      # --- Data Storage (S3) ---
      STORAGE_PROVIDER: s3
      S3_ACCESS_KEY_ID: ${S3_STORAGE_ACCESS_KEY}
      S3_SECRET_ACCESS_KEY: ${S3_STORAGE_SECRET_KEY}
      S3_REGION_NAME: us-east-1
      S3_BUCKET_NAME: open-webui
      S3_ENDPOINT_URL: http://{{ 'localhost' if stage == 'dev' else 'seaweedfs-s3' }}:9000

      # --- Model & AI-Hub Connection ---
      MODELS_CACHE_TTL: 60
      OPENAI_API_BASE_URL: http://{{ 'localhost' if stage == 'dev' else 'api' }}:8000/api/v1/openai
      OPENAI_API_KEY: ${SUPERUSER_TOKEN}
      TASK_MODEL: text-generation/nano
      TASK_MODEL_EXTERNAL: text-generation/nano
      ENABLE_OLLAMA_API: False
      ENABLE_OPENAI_API: True

      # --- Image Generation ---
      IMAGE_GENERATION_MODEL: image-generation
      IMAGES_OPENAI_API_BASE_URL: http://{{ 'localhost' if stage == 'dev' else 'api' }}:8000/api/v1/openai
      IMAGES_OPENAI_API_KEY: ${SUPERUSER_TOKEN}
      IMAGE_SIZE: 1024x1024
      ENABLE_IMAGE_GENERATION: True

      # --- Audio STT ---
      AUDIO_STT_ENGINE: openai
      AUDIO_STT_MODEL: transcription
      AUDIO_STT_OPENAI_API_BASE_URL: http://{{ 'localhost' if stage == 'dev' else 'api' }}:8000/api/v1/openai
      AUDIO_STT_OPENAI_API_KEY: ${SUPERUSER_TOKEN}

      # --- Audio TTS ---
      AUDIO_TTS_ENGINE: openai
      AUDIO_TTS_MODEL: speech
      AUDIO_TTS_OPENAI_API_BASE_URL: http://{{ 'localhost' if stage == 'dev' else 'api' }}:8000/api/v1/openai
      AUDIO_TTS_OPENAI_API_KEY: ${SUPERUSER_TOKEN}
      AUDIO_TTS_VOICE: alloy

      # --- AI-Hub Internal Connection ---
      AIHUB_BASE_URL: http://{{ 'localhost' if stage == 'dev' else 'api' }}:8000
      AIHUB_FRONTEND_URL: {{ 'http://localhost:3000' if stage == 'dev' else 'https://${DOMAIN}' }}
      AIHUB_SUPERUSER_API_KEY: ${SUPERUSER_TOKEN}
      OPEN_WEBUI_SIGNING_SECRET: ${AUTH_OPEN_WEBUI_SIGNING_SECRET}
      AIHUB_PIPELINE_PREFIX: "aihub/"
      AIHUB_REQUEST_TIMEOUT: 60

      # --- Database & Cache ---
      DATABASE_TYPE: postgres
      DATABASE_USER: ${POSTGRES_USER}
      DATABASE_PASSWORD: ${POSTGRES_PASSWORD}
      DATABASE_HOST: {{ 'localhost' if stage == 'dev' else 'postgres' }}
      DATABASE_PORT: 5432
      DATABASE_NAME: openwebui
      REDIS_URL: redis://default:${REDIS_TOKEN}@{{ 'localhost' if stage == 'dev' else 'valkey' }}:6379/10
      REDIS_KEY_PREFIX: open-webui

      # --- Web Server ---
      UVICORN_WORKERS: {{ '1' if stage == 'dev' else '8' }}
      ENABLE_WEBSOCKET_SUPPORT: True
      WEBSOCKET_MANAGER: redis
      WEBSOCKET_REDIS_URL: redis://default:${REDIS_TOKEN}@{{ 'localhost' if stage == 'dev' else 'valkey' }}:6379/11
      THREAD_POOL_SIZE: {{ '8' if stage == 'dev' else '32' }}
      CORS_ALLOW_ORIGIN: "https://openwebui.${DOMAIN},https://${DOMAIN}"

      # --- Admin ---
      ENABLE_ADMIN_EXPORT: True
      ENABLE_ADMIN_CHAT_ACCESS: False
      SHOW_ADMIN_DETAILS: True
      ADMIN_EMAIL: ${ADMIN_EMAIL}

      # --- Code Execution ---
      CODE_EXECUTION_ENGINE: jupyter
      CODE_EXECUTION_JUPYTER_URL: http://{{ 'localhost' if stage == 'dev' else 'jupyter' }}:8888
      CODE_EXECUTION_JUPYTER_AUTH: token
      CODE_EXECUTION_JUPYTER_AUTH_TOKEN: ${JUPYTER_TOKEN}
      CODE_INTERPRETER_ENGINE: jupyter
      CODE_INTERPRETER_JUPYTER_URL: http://{{ 'localhost' if stage == 'dev' else 'jupyter' }}:8888
      CODE_INTERPRETER_JUPYTER_AUTH: token
      CODE_INTERPRETER_JUPYTER_AUTH_TOKEN: ${JUPYTER_TOKEN}

      # --- Vector DB ---
      VECTOR_DB: milvus
      MILVUS_DB: default
      MILVUS_URI: http://{{ 'localhost' if stage == 'dev' else 'milvus-standalone' }}:19530
      MILVUS_TOKEN: root:${MILVUS_ROOT_PASSWORD}
      MILVUS_INDEX_TYPE: HNSW
      MILVUS_METRIC_TYPE: COSINE
      MILVUS_HNSW_M: 16
      MILVUS_HNSW_EFCONSTRUCTION: 256

      # --- RAG & Document Processing ---
      RAG_FULL_CONTEXT: True
      RAG_EMBEDDING_BATCH_SIZE: 64
      PDF_EXTRACT_IMAGES: True
      RAG_FILE_MAX_COUNT: 4
      CONTENT_EXTRACTION_ENGINE: external
      EXTERNAL_DOCUMENT_LOADER_URL: http://{{ 'localhost' if stage == 'dev' else 'api' }}:8000/api/v1/parsing
      EXTERNAL_DOCUMENT_LOADER_API_KEY: ${SUPERUSER_TOKEN}
      RAG_EMBEDDING_ENGINE: openai
      RAG_EMBEDDING_MODEL: embedding/large
      RAG_OPENAI_API_BASE_URL: http://{{ 'localhost' if stage == 'dev' else 'api' }}:8000/api/v1/openai
      RAG_OPENAI_API_KEY: ${SUPERUSER_TOKEN}

      # --- Web Search ---
      ENABLE_WEB_SEARCH: True
      WEB_SEARCH_ENGINE: jina
      JINA_API_KEY: ${JINA_API_KEY}
      WEB_SEARCH_RESULT_COUNT: 6
      WEB_SEARCH_CONCURRENT_REQUESTS: 6
      BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL: True
      WEB_LOADER_ENGINE: playwright
      PLAYWRIGHT_WS_URL: {{ PLAYWRIGHT_WS_URL }}
      FILE_IMAGE_COMPRESSION_WIDTH: 796
      FILE_IMAGE_COMPRESSION_HEIGHT: 796

      # --- User Permissions (consistent across stages) ---
      USER_PERMISSIONS_WORKSPACE_MODELS_ACCESS: False
      USER_PERMISSIONS_WORKSPACE_KNOWLEDGE_ACCESS: False
      USER_PERMISSIONS_WORKSPACE_PROMPTS_ACCESS: False
      USER_PERMISSIONS_WORKSPACE_TOOLS_ACCESS: False
      USER_PERMISSIONS_WORKSPACE_MODELS_ALLOW_PUBLIC_SHARING: False
      USER_PERMISSIONS_WORKSPACE_KNOWLEDGE_ALLOW_PUBLIC_SHARING: False
      USER_PERMISSIONS_WORKSPACE_PROMPTS_ALLOW_PUBLIC_SHARING: False
      USER_PERMISSIONS_WORKSPACE_TOOLS_ALLOW_PUBLIC_SHARING: False
      USER_PERMISSIONS_CHAT_CONTROLS: True
      USER_PERMISSIONS_CHAT_SYSTEM_PROMPT: True
      USER_PERMISSIONS_CHAT_FILE_UPLOAD: True
      USER_PERMISSIONS_CHAT_DELETE: True
      USER_PERMISSIONS_CHAT_EDIT: True
      USER_PERMISSIONS_CHAT_SHARE: False
      USER_PERMISSIONS_CHAT_EXPORT: False
      USER_PERMISSIONS_CHAT_STT: True
      USER_PERMISSIONS_CHAT_TTS: True
      USER_PERMISSIONS_CHAT_CALL: True
      USER_PERMISSIONS_CHAT_MULTIPLE_MODELS: True
      USER_PERMISSIONS_CHAT_TEMPORARY: True
      USER_PERMISSIONS_CHAT_TEMPORARY_ENFORCED: False
      USER_PERMISSIONS_FEATURES_DIRECT_TOOL_SERVERS: False
      USER_PERMISSIONS_FEATURES_WEB_SEARCH: True
      USER_PERMISSIONS_FEATURES_IMAGE_GENERATION: True
      USER_PERMISSIONS_FEATURES_CODE_INTERPRETER: True
      USER_PERMISSIONS_FEATURES_NOTES: True
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    {%- if stage != 'dev' %}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      # --- Routers ---
      - "traefik.http.routers.openwebui-api-auth.rule=Host(`openwebui.${DOMAIN}`) && PathPrefix(`/api/v1/auths`)"
      - "traefik.http.routers.openwebui-api-auth.priority=7000"
      - "traefik.http.routers.openwebui-api-auth.entrypoints=websecure"
      - "traefik.http.routers.openwebui-api-auth.middlewares=openwebui-api-middleware"
      - "traefik.http.routers.openwebui-api.rule=Host(`openwebui.${DOMAIN}`) && PathPrefix(`/api`)"
      - "traefik.http.routers.openwebui-api.priority=6000"
      - "traefik.http.routers.openwebui-api.entrypoints=websecure"
      - "traefik.http.routers.openwebui-api.middlewares=openwebui-api-middleware"
      - "traefik.http.routers.openwebui-static.rule=Host(`openwebui.${DOMAIN}`) && (PathPrefix(`/oauth`) || PathPrefix(`/assets`) || PathPrefix(`/_app`) || PathPrefix(`/static`))"
      - "traefik.http.routers.openwebui-static.priority=2000"
      - "traefik.http.routers.openwebui-static.entrypoints=websecure"
      - "traefik.http.routers.openwebui-static.middlewares=openwebui-static-middleware"
      - "traefik.http.routers.openwebui-path.rule=Host(`openwebui.${DOMAIN}`) && PathPrefix(`/openwebui`)"
      - "traefik.http.routers.openwebui-path.priority=3000"
      - "traefik.http.routers.openwebui-path.entrypoints=websecure"
      - "traefik.http.routers.openwebui-path.middlewares=openwebui-strip-middleware"
      - "traefik.http.routers.openwebui-default.rule=Host(`openwebui.${DOMAIN}`)"
      - "traefik.http.routers.openwebui-default.priority=500"
      - "traefik.http.routers.openwebui-default.entrypoints=websecure"
      - "traefik.http.routers.openwebui-default.middlewares=openwebui-default-middleware"
      # --- TLS Resolver Logic ---
      {%- if stage not in ['local', 'build'] %}
      - "traefik.http.routers.openwebui-api-auth.tls.certresolver=letsencrypt"
      - "traefik.http.routers.openwebui-api.tls.certresolver=letsencrypt"
      - "traefik.http.routers.openwebui-static.tls.certresolver=letsencrypt"
      - "traefik.http.routers.openwebui-path.tls.certresolver=letsencrypt"
      - "traefik.http.routers.openwebui-default.tls.certresolver=letsencrypt"
      {%- else %}
      - "traefik.http.routers.openwebui-api-auth.tls=true"
      - "traefik.http.routers.openwebui-api.tls=true"
      - "traefik.http.routers.openwebui-static.tls=true"
      - "traefik.http.routers.openwebui-path.tls=true"
      - "traefik.http.routers.openwebui-default.tls=true"
      {%- endif %}
      # --- Service ---
      - "traefik.http.services.openwebui.loadbalancer.server.port=8080"
      # --- Middlewares ---
      - "traefik.http.middlewares.openwebui-api-middleware.chain.middlewares=security-headers@file,openwebui-iframe,openwebui-forwarded-headers"
      - "traefik.http.middlewares.openwebui-static-middleware.chain.middlewares=security-headers@file,openwebui-iframe"
      - "traefik.http.middlewares.openwebui-strip-middleware.chain.middlewares=openwebui-strip-prefix,security-headers@file,openwebui-iframe"
      - "traefik.http.middlewares.openwebui-strip-prefix.stripprefix.prefixes=/openwebui"
      - "traefik.http.middlewares.openwebui-default-middleware.chain.middlewares=security-headers@file,openwebui-iframe,openwebui-forwarded-headers"
      - "traefik.http.middlewares.openwebui-iframe.headers.customResponseHeaders.Content-Security-Policy=frame-ancestors 'self' https://${DOMAIN}"
      - "traefik.http.middlewares.openwebui-iframe.headers.customResponseHeaders.X-Frame-Options=SAMEORIGIN"
      - "traefik.http.middlewares.openwebui-forwarded-headers.headers.customrequestheaders.X-Forwarded-Proto=https"
      - "traefik.http.middlewares.openwebui-forwarded-headers.headers.customrequestheaders.X-Forwarded-Host=openwebui.${DOMAIN}"
      - "traefik.http.middlewares.openwebui-forwarded-headers.headers.customRequestHeaders.X-Forwarded-Port=443"
      - "traefik.http.middlewares.openwebui-forwarded-headers.headers.customRequestHeaders.X-Real-IP=%{remote_addr}"
    {%- endif %}
    {%- if stage != 'dev' %}
    networks:
      - proxy
      - backend
      - data
      - storage
    {%- endif %}

  openwebui-init:
    container_name: openwebui-init
    image: {{ global.registry_prefix }}postgres:17
    restart: "no"
    depends_on:
      open-webui:
        condition: service_healthy
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_DB: openwebui
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - ./configs/openwebui/init-functions.sh:/init-functions.sh:ro
      - ./configs/openwebui/functions:/functions:ro
    entrypoint: ["/bin/sh", "/init-functions.sh"]
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - data

  {% if image_tags.dagster[stage] %}
  # ===================================================================
  # Dagster Stack (Data Pipeline Orchestration)
  # ===================================================================
  # This stack runs the data pipelines, managed by the Dagster UI
  # and backend daemon. It's only present in non-dev stages.
  # ===================================================================
  oauth2proxy-dagster:
    container_name: oauth2proxy-dagster
    image: {{ image_tags.oauth2proxy }}
    restart: always
    environment:
      OAUTH2_PROXY_HTTP_ADDRESS: 0.0.0.0:4180
      OAUTH2_PROXY_COOKIE_SECURE: False
      OAUTH2_PROXY_CODE_CHALLENGE_METHOD: S256
      OAUTH2_PROXY_UPSTREAMS: {{ DAGSTER_WEBSERVER_URL }}
      OAUTH2_PROXY_CLIENT_ID: oauth2-proxy-dagster
      OAUTH2_PROXY_PROVIDER: oidc
      OAUTH2_PROXY_PROVIDER_DISPLAY_NAME: ${OAUTH_PROVIDER_NAME}
      OAUTH2_PROXY_SKIP_OIDC_DISCOVERY: "true"
      OAUTH2_PROXY_OIDC_ISSUER_URL: https://auth.${DOMAIN}/realms/{{ KEYCLOAK_REALM }}
      OAUTH2_PROXY_LOGIN_URL: https://auth.${DOMAIN}/realms/{{ KEYCLOAK_REALM }}/protocol/openid-connect/auth
      OAUTH2_PROXY_REDEEM_URL: {{ KEYCLOAK_INTERNAL_URL }}/realms/{{ KEYCLOAK_REALM }}/protocol/openid-connect/token
      OAUTH2_PROXY_OIDC_JWKS_URL: {{ KEYCLOAK_INTERNAL_URL }}/realms/{{ KEYCLOAK_REALM }}/protocol/openid-connect/certs
      OAUTH2_PROXY_COOKIE_SECRET: ${OAUTH_COOKIE_SECRET_DAGSTER}
      OAUTH2_PROXY_CLIENT_SECRET: ${KEYCLOAK_OAUTH2_PROXY_DAGSTER_SECRET}
      OAUTH2_PROXY_EMAIL_DOMAINS: "*"
      OAUTH2_PROXY_REVERSE_PROXY: True
      OAUTH2_PROXY_REDIRECT_URL: https://dagster.${DOMAIN}
      OAUTH2_PROXY_SCOPE: openid email profile roles
      OAUTH2_PROXY_ALLOWED_GROUPS: ${OAUTH_ALLOWED_GROUPS_DAGSTER}
      OAUTH2_PROXY_OIDC_GROUPS_CLAIM: roles
      OAUTH2_PROXY_CUSTOM_SIGN_IN_LOGO: ${OAUTH_CUSTOM_SIGN_IN_LOGO}
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      - "traefik.http.routers.dagster.rule=Host(`dagster.${DOMAIN}`)"
      - "traefik.http.routers.dagster.entrypoints=websecure"
      - "traefik.http.routers.dagster.middlewares=security-headers@file"
      - "traefik.http.services.dagster.loadbalancer.server.port=4180"
      {%- if stage not in ['local', 'build'] %}
      - "traefik.http.routers.dagster.tls.certresolver=letsencrypt"
      {%- else %}
      - "traefik.http.routers.dagster.tls=true"
      {%- endif %}
    networks:
      - proxy
      - backend

  dagster-webserver:
    container_name: dagster-webserver
    restart: always
    {%- if image_tags.dagster[stage] == 'localbuild' %}
    build:
      context: .
      dockerfile: ./aihub_pipeline/Dockerfile
    {%- else %}
    image: {{ global.registry_prefix }}{{ image_tags.dagster[stage] }}
    {%- endif %}
    depends_on:
      pgbouncer:
        condition: service_healthy
    {%- if stage in ['dev', 'local', 'build'] %}
    ports:
      - "3002:3000"
    {%- endif %}
    entrypoint:
      - dagster-webserver
      - -h
      - 0.0.0.0
      - -p
      - '3000'
      - -w
      - /dagster_home/workspace.yaml
    volumes:
      - ./configs/dagster/dagster-config.{{ stage_postfix }}.yml:/dagster_home/dagster.yaml:ro
      - ./configs/dagster/workspace.{{ stage_postfix }}.yml:/dagster_home/workspace.yaml:ro
    environment:
      PYTHONUNBUFFERED: 1
      DAGSTER_HOME: /dagster_home
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      LOG_LEVEL: ${LOG_LEVEL}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/server_info"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - backend
      - data

  dagster-daemon:
    container_name: dagster-daemon
    restart: always
    {%- if image_tags.dagster[stage] == 'localbuild' %}
    build:
      context: .
      dockerfile: ./aihub_pipeline/Dockerfile
    {%- else %}
    image: "{{ global.registry_prefix }}{{ image_tags.dagster[stage] }}"
    {%- endif %}
    depends_on:
      pgbouncer:
        condition: service_healthy
    entrypoint:
      - dagster-daemon
      - run
    volumes:
      - ./configs/dagster/dagster-config.{{ stage_postfix }}.yml:/dagster_home/dagster.yaml:ro
      - ./configs/dagster/workspace.{{ stage_postfix }}.yml:/dagster_home/workspace.yaml:ro
    environment:
      PYTHONUNBUFFERED: 1
      DAGSTER_HOME: /dagster_home
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      LOG_LEVEL: ${LOG_LEVEL}
    healthcheck:
      test: ["CMD", "dagster-daemon", "liveness-check"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    networks:
      - backend
      - data
  {%- endif %}

  {% if stage != 'dev' %}
  # ===================================================================
  # Docker Socket Proxy (Security Layer)
  # ===================================================================
  # Provides filtered, read-only access to the Docker socket for Traefik.
  # This prevents potential container escape attacks if Traefik is
  # compromised, as the proxy only exposes the minimal Docker API
  # endpoints required for service discovery.
  # ===================================================================
  docker-socket-proxy:
    container_name: docker-socket-proxy
    image: "{{ image_tags.docker_socket_proxy }}"
    restart: always
    # Required for Docker socket access in SELinux/AppArmor environments
    privileged: true
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:2375/_ping"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 5s
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      # Security: Only enable required Docker API sections
      CONTAINERS: 1    # Required for Traefik to discover services
      NETWORKS: 1      # Required for Traefik network routing
      # Explicitly disable dangerous permissions (defaults are already 0, but explicit is clearer)
      BUILD: 0
      COMMIT: 0
      CONFIGS: 0
      DISTRIBUTION: 0
      EXEC: 0
      IMAGES: 0
      POST: 0
      SECRETS: 0
      SERVICES: 0
      SWARM: 0
      SYSTEM: 0
      TASKS: 0
      VOLUMES: 0
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: 2
    labels:
      - "traefik.enable=false"
    networks:
      - backend  # Only Traefik needs to access this service

  # ===================================================================
  # Traefik (Reverse Proxy)
  # ===================================================================
  # Traefik manages incoming traffic, TLS, and routing to services.
  # It is only enabled in non-dev stages.
  # ===================================================================
  traefik:
    container_name: traefik
    image: "{{ global.registry_prefix }}{{ image_tags.traefik }}"
    restart: always
    depends_on:
      docker-socket-proxy:
        condition: service_healthy
    healthcheck:
      test: [ "NONE" ]
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - "./configs/traefik/traefik-config.{{ stage_postfix }}.yml:/etc/traefik/traefik.yml:ro"
      - "./configs/traefik/middlewares.{{ stage_postfix }}.yml:/etc/traefik/dynamic/middlewares.yml:ro"
      {%- if stage in ['dev', 'local', 'build'] %}
      - "./configs/traefik/tls.{{ stage_postfix }}.yml:/etc/traefik/dynamic/tls.yml:ro"
      - "./configs/traefik/certs/dev-cert.pem:/certs/dev-cert.pem:ro"
      - "./configs/traefik/certs/dev-key.pem:/certs/dev-key.pem:ro"
      {%- else %}
      - "/srv/app/traefik/acme.json:/etc/traefik/acme.json"
      {%- endif %}
    environment:
      TRAEFIK_LOG_LEVEL: ${LOG_LEVEL}
      {%- if stage not in ['dev', 'local', 'build'] %}
      TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_EMAIL: ${ACME_EMAIL}
      {%- endif %}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      # --- HTTP to HTTPS Redirect and ACME Challenge ---
      {%- if stage in ['latest', 'nightly'] %}
      - "traefik.http.routers.acme-challenge.rule=PathPrefix(`/.well-known/acme-challenge/`)"
      - "traefik.http.routers.acme-challenge.entrypoints=web"
      - "traefik.http.routers.acme-challenge.priority=9000"
      {%- endif %}
      - "traefik.http.routers.http-catch.rule=HostRegexp(`{host:.+}`) && !PathPrefix(`/.well-known/acme-challenge/`)"
      - "traefik.http.routers.http-catch.entrypoints=web"
      - "traefik.http.routers.http-catch.priority=10"
      - "traefik.http.routers.http-catch.middlewares=https-redirect"
      - "traefik.http.middlewares.https-redirect.redirectscheme.scheme=https"
      # --- Dashboard ---
      {%- if stage not in ['dev', 'local', 'build'] %}
      - "traefik.http.routers.traefik.tls.certresolver=letsencrypt"
      {%- else %}
      - "traefik.http.routers.traefik.tls=true"
      {%- endif %}
      - "traefik.http.routers.traefik.rule=Host(`traefik.${DOMAIN}`)"
      - "traefik.http.routers.traefik.entrypoints=websecure"
      - "traefik.http.routers.traefik.service=api@internal"
      - "traefik.http.middlewares.traefik-auth.basicauth.users=admin:${ADMIN_PASSWORD_HASH}"
      - "traefik.http.routers.traefik.middlewares=traefik-auth"
    networks:
      - proxy
      - backend  # Traefik routes to backend services
  {%- endif %}

  {% if image_tags.api[stage] %}
  # ===================================================================
  # API Stack (Backend Logic)
  # ===================================================================
  # This is the main backend API for the AI Hub. It is not present
  # in the 'dev' stage.
  # ===================================================================
  api:
    container_name: api
    restart: always
    {%- if image_tags.api[stage] == 'localbuild' %}
    build:
      context: .
      dockerfile: ./aihub_api/Dockerfile
    {%- else %}
    image: {{ global.registry_prefix }}{{ image_tags.api[stage] }}
    {%- endif %}
    depends_on:
      nats:
        condition: service_started
      traefik:
        condition: service_started
      ferretdb:
        condition: service_started
      milvus-standalone:
        condition: service_healthy
      neo4j:
        condition: service_healthy
      mineru-api:
        condition: service_healthy
    environment:
      # Log Level
      LOG_LEVEL: ${LOG_LEVEL}
      ENV: ${ENV}
      NUM_WORKERS: 1

      # General Auth settings
      AUTH_ENABLE_API_ACCESS: True
      AUTH_OPEN_WEBUI_SIGNING_SECRET: ${AUTH_OPEN_WEBUI_SIGNING_SECRET}
      AUTH_IDENTITY_PROVIDER: ${AUTH_IDENTITY_PROVIDER}

      # Keycloak OIDC config
      KEYCLOAK_URL: {{ KEYCLOAK_INTERNAL_URL }}
      KEYCLOAK_EXTERNAL_URL: https://auth.${DOMAIN}
      KEYCLOAK_REALM: {{ KEYCLOAK_REALM }}

      # Oauth2 config
      OAUTH_CLIENT_ID: ${OAUTH_CLIENT_ID}
      OAUTH_CLIENT_SECRET: ${OAUTH_CLIENT_SECRET}
      OAUTH_AUTHORITY_URL: ${OAUTH_AUTHORITY_URL}

      # Azure Oauth2 config
      AZURE_CLIENT_ID: ${OAUTH_CLIENT_ID}
      AZURE_TENANT_ID: ${OAUTH_TENANT_ID}
      AZURE_CLIENT_SECRET: ${OAUTH_CLIENT_SECRET}

      # Superuser
      SUPERUSER_ENABLED: True
      SUPERUSER_NAME: ${SUPERUSER_NAME}
      SUPERUSER_EMAIL: ${SUPERUSER_EMAIL}
      SUPERUSER_OID: ${SUPERUSER_OID}
      SUPERUSER_ROLE: AIHubSuperuser
      SUPERUSER_TOKEN: ${SUPERUSER_TOKEN}

      # AI-Hub Settings
      AIHUB_API_VERSION: ${AIHUB_API_VERSION}
      AIHUB_FRONTEND_ORIGIN: ${DOMAIN}
      AIHUB_CREATE_DEFAULT_ROLES: True
      AIHUB_CREATE_DEFAULT_BUCKETS: True
      AIHUB_DEFAULT_BUCKET_NAME: ${AIHUB_DEFAULT_BUCKET_NAME}
      AIHUB_SHARED_BUCKET_NAME: ${AIHUB_SHARED_BUCKET_NAME}
      AIHUB_DEFAULT_NAMESPACE_NAME: ${AIHUB_DEFAULT_NAMESPACE_NAME}
      AIHUB_SHARED_NAMESPACE_NAME: ${AIHUB_SHARED_NAMESPACE_NAME}

      # LiteLLM Access
      LITE_LLM_PROXY_BASE_URL: {{ LITE_LLM_PROXY_BASE_URL }}
      LITE_LLM_PROXY_API_KEY: ${LITELLM_MASTER_KEY}

      # Mongo DB
      MONGO_CONNECTION_STRING: mongodb://${MONGO_USERNAME}:${MONGO_PASSWORD}@ferretdb:27017/

      # MILVUS
      MILVUS_URL: {{ MILVUS_ENDPOINT }}
      MILVUS_DIMENSION: ${MILVUS_DIMENSION}
      MILVUS_ROOT_PASSWORD: ${MILVUS_ROOT_PASSWORD}

      # S3 Access connection
      S3_STORAGE_ENDPOINT: {{ S3_STORAGE_ENDPOINT }}
      S3_STORAGE_PUBLIC_ENDPOINT: {{ S3_STORAGE_PUBLIC_ENDPOINT }}
      S3_STORAGE_ACCESS_KEY: ${S3_STORAGE_ACCESS_KEY}
