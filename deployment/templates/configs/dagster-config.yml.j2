# ===================================================================
# Dagster Configuration - Stage: {{ stage }}
# ===================================================================
# Generated from template. Do not edit directly.
{%- if stage != 'dev' %}
# Uses PgBouncer (pgbouncer:6432) for connection pooling to prevent exhaustion.
{%- else %}
# Connects directly to PostgreSQL (postgres:5432) without PgBouncer.
{%- endif %}
# ===================================================================

run_storage:
  module: dagster_postgres.run_storage
  class: PostgresRunStorage
  config:
    postgres_db:
{%- if stage != 'dev' %}
      hostname: pgbouncer
{%- else %}
      hostname: postgres
{%- endif %}
      username:
        env: POSTGRES_USER
      password:
        env: POSTGRES_PASSWORD
      db_name: dagster
{%- if stage != 'dev' %}
      port: 6432
{%- else %}
      port: 5432
{%- endif %}

event_log_storage:
  module: dagster_postgres.event_log
  class: PostgresEventLogStorage
  config:
    postgres_db:
{%- if stage != 'dev' %}
      hostname: pgbouncer
{%- else %}
      hostname: postgres
{%- endif %}
      username:
        env: POSTGRES_USER
      password:
        env: POSTGRES_PASSWORD
      db_name: dagster
{%- if stage != 'dev' %}
      port: 6432
{%- else %}
      port: 5432
{%- endif %}

schedule_storage:
  module: dagster_postgres.schedule_storage
  class: PostgresScheduleStorage
  config:
    postgres_db:
{%- if stage != 'dev' %}
      hostname: pgbouncer
{%- else %}
      hostname: postgres
{%- endif %}
      username:
        env: POSTGRES_USER
      password:
        env: POSTGRES_PASSWORD
      db_name: dagster
{%- if stage != 'dev' %}
      port: 6432
{%- else %}
      port: 5432
{%- endif %}

compute_logs:
  module: dagster.core.storage.noop_compute_log_manager
  class: NoOpComputeLogManager

run_launcher:
  module: dagster.core.launcher
  class: DefaultRunLauncher

run_coordinator:
  module: dagster.core.run_coordinator
  class: QueuedRunCoordinator
  config:
{%- if stage == "local" %}
    max_concurrent_runs: 2
{%- elif stage == "nightly" %}
    max_concurrent_runs: 3
{%- elif stage == "latest" %}
    max_concurrent_runs: 5
{%- else %}
    max_concurrent_runs: 2
{%- endif %}

telemetry:
  enabled: false