# ===================================================================
# NATS Server Configuration (Auto-Generated)
# ===================================================================
# This file is auto-generated from a Jinja2 template.
# DO NOT EDIT THIS FILE DIRECTLY.
#
# To make changes, edit the following files and then run the generator script:
#   - deployment/compose-config.yml (for changing values)
#   - deployment/templates/configs/nats-config.conf.j2 (for changing structure)
#
# Stage: {{ stage }}
# Server: nats-1 (seed node)
# ===================================================================

# Debug and Tracing
# Verbose logging for development, minimal for production
{%- if stage in ['dev', 'local', 'build'] %}
debug: true
trace: true
trace_verbose: false
{%- else %}
debug: false
trace: false
trace_verbose: false
{%- endif %}
logtime: true

# Server Identity
# Unique name per stage
server_name: nats-{{ stage }}

# Client Connections
listen: 0.0.0.0:4222

# Monitoring Endpoint
http: 8222

# ===================================================================
# Token-Based Authentication
# ===================================================================
# All clients must provide this token to connect.
# Token is read from environment variable NATS_TOKEN.
# ===================================================================
authorization {
  token: $NATS_TOKEN
}

# Performance Settings
# Conservative for dev, aggressive for production
max_control_line: 4KB

{%- if stage in ['dev', 'local', 'build'] %}
# Development: Smaller limits for faster feedback
max_payload: 1MB
max_pending: 512MB
max_connections: 64
{%- else %}
# Production: Larger limits for higher throughput
max_payload: 2MB
max_pending: 2GB
max_connections: 256
{%- endif %}

# Health Check Settings
ping_interval: "2m"
ping_max: 2
write_deadline: "10s"

# JetStream Configuration
# Persistent message streaming and storage
jetstream {
  # Storage location for JetStream data
  store_dir: "/data/nats/js-store"

  # Domain matches deployment stage for isolation
  domain: "{{ stage }}"

  # Sync interval for durability
{%- if stage in ['dev', 'local', 'build'] %}
  sync_interval: "1m"  # More frequent sync for dev (data safety)
{%- else %}
  sync_interval: "2m"  # Less frequent for production (performance)
{%- endif %}

  # Max memory and storage
{%- if stage in ['dev', 'local', 'build'] %}
  max_memory_store: 512MB    # Dev: 512MB memory limit
  max_file_store: 10GB       # Dev: 10GB disk limit
{%- else %}
  max_memory_store: 2GB      # Prod: 2GB memory limit
  max_file_store: 50GB       # Prod: 50GB disk limit
{%- endif %}
}

# Limits per account
{%- if stage in ['dev', 'local', 'build'] %}
# Development: Relaxed limits
max_subscriptions: 1000
max_payload: 1MB
{%- else %}
# Production: Higher limits
max_subscriptions: 5000
max_payload: 2MB
{%- endif %}