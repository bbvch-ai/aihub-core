#!/bin/sh
# This file is auto-generated from a Jinja2 template.
# DO NOT EDIT THIS FILE DIRECTLY.
#
# To make changes, edit deployment/templates/configs/s3-init-buckets.sh.j2

echo "Waiting for S3 to be ready..."
sleep 5

ENDPOINT=${S3_ENDPOINT:-"http://seaweedfs-s3:9000"}
FILER_ENDPOINT=${FILER_ENDPOINT:-"http://seaweedfs-filer:8888"}
BUCKETS=${DEFAULT_BUCKETS:-"open-webui milvus defaultknowledge"}

# Create CORS configuration file
cat > /tmp/cors.json <<EOF
{
  "CORSRules": [
    {
      "AllowedHeaders": ["Content-Type", "x-amz-date", "authorization", "x-amz-security-token", "x-amz-content-sha256"],
      "AllowedMethods": ["GET", "PUT", "POST", "DELETE", "HEAD"],
      "AllowedOrigins": ["*"],
      "ExposeHeaders": ["ETag", "x-amz-request-id", "x-amz-id-2", "x-amz-server-side-encryption"],
      "MaxAgeSeconds": 3000
    }
  ]
}
EOF

# Function to create bucket via filer API (fallback for SeaweedFS inconsistencies)
create_bucket_via_filer() {
  bucket=$1
  echo "Attempting to create bucket via filer API: $bucket"
  # Use wget since curl may not be available in alpine
  if wget -q -O /dev/null --method=POST "${FILER_ENDPOINT}/buckets/${bucket}/" 2>/dev/null; then
    echo "Created bucket via filer: $bucket"
    return 0
  else
    echo "Filer API bucket creation failed for: $bucket"
    return 1
  fi
}

echo "Creating buckets and configuring CORS..."
for bucket in $BUCKETS; do
  # Create bucket if it doesn't exist
  if aws --endpoint-url $ENDPOINT s3 ls s3://$bucket 2>/dev/null; then
    echo "Bucket $bucket already exists"
  else
    # Try S3 API first
    if aws --endpoint-url $ENDPOINT s3 mb s3://$bucket 2>/dev/null; then
      echo "Created bucket via S3: $bucket"
    else
      # Fallback to filer API if S3 fails (handles SeaweedFS collection name conflicts)
      create_bucket_via_filer $bucket || echo "Warning: Could not create bucket $bucket"
    fi
  fi

  # Apply CORS configuration to the bucket
  echo "Configuring CORS for bucket: $bucket"
  aws --endpoint-url $ENDPOINT s3api put-bucket-cors \
    --bucket $bucket \
    --cors-configuration file:///tmp/cors.json 2>/dev/null || echo "CORS configuration might already be set"

  # Verify CORS configuration (optional)
  echo "Verifying CORS configuration for $bucket:"
  aws --endpoint-url $ENDPOINT s3api get-bucket-cors --bucket $bucket 2>/dev/null || echo "No CORS configuration found"
done

echo "Bucket initialization and CORS configuration complete!"
