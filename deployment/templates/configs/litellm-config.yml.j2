{# Extract model aliases from service configs #}
{%- set llama_cpp_alias = 'gemma-3-4b' -%}
{%- set llama_cpp_docling_alias = 'granite-docling' -%}
{%- if stage in ['nightly', 'latest'] -%}
{%- set llama_cpp_alias = 'gemma-3-12b' -%}
{%- endif %}

