# =============================================================================
# LOCAL DEVELOPMENT OVERRIDES
# =============================================================================
# Variables in this section are ONLY needed when running AI-Hub Python services
# (api, agents, pipelines) directly on the host while the rest of the stack runs
# in Docker. Docker-only deployments (`make up`) do not consume any of these —
# the compose template supplies the in-Docker equivalents to each container.
#
# Each entry below maps a Pydantic settings field to the host-port-mapped
# endpoint of the corresponding Docker service.
# =============================================================================

# Keycloak (host-side reach via mapped port)
KEYCLOAK_URL='http://localhost:8180'

# OpenWebUI (host-side reach)
OPENWEBUI_BASE_URL='http://localhost:8080'

# Neo4j (host-side reach)
