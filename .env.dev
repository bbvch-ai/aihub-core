# -----------------------------------------------------------------------------
# AI-Hub Application Settings
# -----------------------------------------------------------------------------
AIHUB_API_VERSION="dev"
AIHUB_CREATE_DEFAULT_ROLES="True"
AIHUB_CREATE_DEFAULT_BUCKETS="True"
AIHUB_DEFAULT_BUCKET_NAME="defaultknowledge"
AIHUB_SHARED_BUCKET_NAME="sharedknowledge"
AIHUB_DEFAULT_NAMESPACE_NAME="defaultnamespace"
AIHUB_SHARED_NAMESPACE_NAME="sharednamespace"

# -----------------------------------------------------------------------------
# Multi-Tenant Configuration
# -----------------------------------------------------------------------------

# Default Tenant Settings
# Default tenant created on first startup (backwards-compatible single-tenant mode)
AIHUB_DEFAULT_TENANT_NAME="Default Organization"
AIHUB_DEFAULT_TENANT_DESCRIPTION="The default organization for all users."
# Access rules for the default tenant (comma-separated). Use "aihub.admin.>" for unrestricted access.
AIHUB_DEFAULT_TENANT_ACCESS_RULES="aihub.admin.>"

# User Signup Settings
# Roles assigned to the very first user (typically admin). Comma-separated.
AIHUB_USER_SIGNUP_FIRST_ADMIN_USER_ROLES="AIHubAdmin"
# Roles assigned to regular users when they sign up (comma-separated)
AIHUB_USER_SIGNUP_REGULAR_USER_ROLES="AIHubUser"

# Admin Settings
ADMIN_EMAIL="admin@ai-hub.bbv.ch"

# OAuth Group Restrictions
OAUTH_ALLOWED_GROUPS_DAGSTER="AIHubDeveloper"
OAUTH_COOKIE_SECRET_DAGSTER="9d6ef5787a9a5ddfa2b26225d62c7504"
OAUTH_ALLOWED_GROUPS_SEAWEEDFS="AIHubDeveloper"
OAUTH_COOKIE_SECRET_SEAWEEDFS="383cb9f1f84ee192358766f910ddd745"
OAUTH_ALLOWED_GROUPS_ATTU="AIHubDeveloper"
OAUTH_COOKIE_SECRET_ATTU="29a798ff3e7a2fa141a8b4c0c8abdd6e"

# -----------------------------------------------------------------------------
# Expert Asking Agent Configuration
# -----------------------------------------------------------------------------
# Channel type: "teams" or "slack"
EXPERT_ASKING_CHANNEL_TYPE="teams"

# Teams Configuration (required if EXPERT_ASKING_CHANNEL_TYPE="teams")
TEAMS_CHANNEL_ID="19:xxxxx@thread.tacv2"
TEAMS_TENANT_ID="00000000-0000-0000-0000-000000000000"
TEAMS_BOT_ID="00000000-0000-0000-0000-000000000000"

# Slack Configuration (required if EXPERT_ASKING_CHANNEL_TYPE="slack")
SLACK_CHANNEL_ID="C00000000"
SLACK_SERVICE_URL="https://slack.botframework.com"

# -----------------------------------------------------------------------------
# Domain Configuration
# -----------------------------------------------------------------------------
# Used for docker-compose.local.yml and production deployments
DOMAIN="127.0.0.1.nip.io"

# -----------------------------------------------------------------------------
# OpenTelemetry Configuration
# -----------------------------------------------------------------------------
OTEL_ENABLED="true"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_EXPORTER_OTLP_PROTOCOL="grpc"
OTEL_RESOURCE_SERVICE_NAME="swiss-ai-hub"
OTEL_RESOURCE_SERVICE_VERSION="0.0.1"
OTEL_RESOURCE_SERVICE_NAMESPACE="swiss-ai-hub"

# Cloud OTEL (optional)
OTEL_CLOUD_ENDPOINT="ingest.eu.signoz.cloud:443"
OTEL_CLOUD_HEADERS="{'signoz-ingestion-key':'XXX'}"

