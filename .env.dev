# -----------------------------------------------------------------------------
# Multi-Tenant Configuration
# -----------------------------------------------------------------------------

# Startup Tenant Settings
# The tenant the platform seeds on first startup. Once created it is an ordinary
# tenant — no special flags, no special treatment. These values only control the
# first-boot seeding.
AIHUB_STARTUP_TENANT_ID='default'
AIHUB_STARTUP_TENANT_NAME='Swiss AI Hub'
AIHUB_STARTUP_TENANT_DESCRIPTION='This tenant was auto-created on startup of the Swiss AI Hub.'
# Access rules for the startup tenant (comma-separated). Use "aihub.admin.>" for unrestricted access.
AIHUB_STARTUP_TENANT_ACCESS_RULES='aihub.admin.>'

# User Signup Settings
# Roles assigned to the very first user (typically admin). Comma-separated.
AIHUB_USER_SIGNUP_FIRST_ADMIN_USER_ROLES='AIHubAdmin,AIHubUser'
# Roles assigned to regular users when they sign up (comma-separated)
AIHUB_USER_SIGNUP_REGULAR_USER_ROLES='AIHubUser'

# Admin Settings
