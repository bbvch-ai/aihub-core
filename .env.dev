# =============================================================================
# AI-Hub Development Environment Configuration
# =============================================================================
# This file contains environment variables for LOCAL DEVELOPMENT with
# infra/docker-compose.dev.yml. Only includes values that are:
# 1. Secrets/credentials that vary per deployment
# 2. Configuration values that are genuinely environment-specific
# 3. Local dev overrides (localhost endpoints for running services outside Docker)
#
# Internal Docker network endpoints are hardcoded in the compose template.
#
# The file has two parts:
#   1. Variables needed by the full docker-compose stack (compose interpolation,
#      container env blocks, secrets). Anything required for `make up` to work.
#   2. The "LOCAL DEVELOPMENT OVERRIDES" block at the bottom — variables only
#      consumed by AI-Hub Python services (api, agents, pipelines) when they
#      run on the HOST instead of inside Docker. Compose-only deployments do
#      not need any of those values.
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
# CRITICAL, FATAL, ERROR, WARN, WARNING, INFO, DEBUG
LOG_LEVEL='DEBUG'
# dev, test, prod
ENV='dev'

# -----------------------------------------------------------------------------
# API Keys (External Services)
# -----------------------------------------------------------------------------
GEMINI_API_KEY='XXX'
HUGGINGFACE_API_KEY='XXX'

# Swiss LLM Cloud (required for all non-GPU setups)
# Each service type may use a different cloud provider/endpoint.
# LLM: text generation models (gemma3n, mistral3)
SWISS_LLM_CLOUD_API_BASE_URL='XXX'
SWISS_LLM_CLOUD_API_KEY='XXX'
# Embedding: vector embedding models (inference-bge-m3)
SWISS_LLM_CLOUD_EMBEDDING_API_BASE_URL='XXX'
SWISS_LLM_CLOUD_EMBEDDING_API_KEY='XXX'
# Reranking: reranking models (inference-bge-reranker), Jina AI compatible endpoint
SWISS_LLM_CLOUD_RERANKING_API_BASE_URL='XXX'
SWISS_LLM_CLOUD_RERANKING_API_KEY='XXX'
# Whisper: audio transcription (whisper-large-v3), OpenAI compatible endpoint
SWISS_LLM_CLOUD_WHISPER_API_BASE_URL='XXX'
SWISS_LLM_CLOUD_WHISPER_API_KEY='XXX'
# OCR: document OCR model (mineru), OpenAI compatible endpoint
SWISS_LLM_CLOUD_OCR_API_BASE_URL='XXX'
SWISS_LLM_CLOUD_OCR_API_KEY='XXX'

# -----------------------------------------------------------------------------
# Keycloak Configuration
# -----------------------------------------------------------------------------
# Keycloak Admin Console credentials
KEYCLOAK_ADMIN_USER='admin'
KEYCLOAK_ADMIN_PASSWORD='admin'

# Client secrets for OIDC clients
KEYCLOAK_OPENWEBUI_CLIENT_SECRET='openwebui-secret-dev'

# API service account (least-privilege: view-identity-providers only)
KEYCLOAK_API_SERVICE_CLIENT_SECRET='aihub-api-service-secret-dev'
KEYCLOAK_SHOW_KEYCLOAK_LOGIN='true'

# OAuth2 Proxy client secrets (one per protected service)
KEYCLOAK_OAUTH2_PROXY_DAGSTER_SECRET='oauth2-proxy-dagster-secret-dev'
KEYCLOAK_OAUTH2_PROXY_DATALAKE_SECRET='oauth2-proxy-datalake-secret-dev'
KEYCLOAK_OAUTH2_PROXY_ATTU_SECRET='oauth2-proxy-attu-secret-dev'
KEYCLOAK_OAUTH2_PROXY_BACKUP_SECRET='oauth2-proxy-backup-secret-dev'
LANGFUSE_KEYCLOAK_CLIENT_SECRET='langfuse-keycloak-secret-dev'

# Superuser (interactive Keycloak-seeded admin). Its realm roles grant access via the
# normal OAuth2 flow — AIHubAccess is the base role required to use the platform (incl.
# OpenWebUI) and AIHubSysAdmin grants sysadmin. Keep both in SUPERUSER_ROLES_JSON.
SUPERUSER_USERNAME='admin'
SUPERUSER_PASSWORD='admin'
SUPERUSER_EMAIL='admin@your-company.com'
SUPERUSER_FIRSTNAME='Admin'
SUPERUSER_LASTNAME='User'
SUPERUSER_ROLES_JSON='["AIHubAccess", "AIHubSysAdmin"]'
# Superuser static bearer token. Seeded into the bearer_tokens collection at
# API startup, bound to the Keycloak user found by SUPERUSER_EMAIL. Internal
# services use this as their API key and authenticate via TokenAuthHandler.
SUPERUSER_TOKEN='sk-9458708a04940cfe9586511ca39b2d66e4d75886dabcc00a663824fbaf525c52'

KEYCLOAK_REALM='aihub'

# Azure Entra ID Identity Provider (for Keycloak federation)
# These are used by Keycloak to federate authentication to Azure Entra ID.
# In dev mode, these can be left as placeholders if not using Azure auth.
# Configure these in your Azure App Registration:
#   - Redirect URI: http://localhost:8180/realms/aihub/broker/azure-ad/endpoint
KEYCLOAK_AZURE_CLIENT_ID=''
KEYCLOAK_AZURE_CLIENT_SECRET=''
KEYCLOAK_AZURE_TENANT_ID=''

# -----------------------------------------------------------------------------
# OAuth2 / OIDC Configuration (Keycloak)
# -----------------------------------------------------------------------------
# All OAuth2/OIDC authentication goes through Keycloak, which acts as an
# identity broker for upstream providers (Azure AD, Google, etc.)
OAUTH_CLIENT_ID='aihub-frontend'
OAUTH_CLIENT_SECRET=''
OAUTH_TENANT_ID=''

# OAuth Custom Branding
OAUTH_CUSTOM_SIGN_IN_LOGO='https://aiagentsstpublicblobs.blob.core.windows.net/logos/Bbv-Logo_farbig.png'

