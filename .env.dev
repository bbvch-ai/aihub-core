# Azure Services (for customer data sources and document processing)

# Azure Data Lake Storage (for customers with data in Azure Data Lake)
# Required: Connection string with account name and key
# Example: Same format as Blob Storage connection string
# AZURE_DATA_LAKE_CONNECTION_STRING="..."

# Azure Document Intelligence (for document parsing/OCR)
# Required: Service endpoint URL and API key
# Example endpoint: "https://yourservice.cognitiveservices.azure.com/"
# Example API key: Get from Azure Portal -> Your Document Intelligence resource -> Keys and Endpoint
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT="https://yourservice.cognitiveservices.azure.com/"
# AZURE_DOCUMENT_INTELLIGENCE_API_KEY="your-api-key-here"
# AZURE_DOCUMENT_INTELLIGENCE_API_VERSION="2024-11-30"

