pr-ready:
	cd aihub_web && pnpm lint

format:
	cd aihub_web && pnpm lint --fix

lint:
	cd aihub_web && pnpm lint

test:
	@echo "No frontend tests configured. See aihub_web/AGENTS.md"

dev:
	cd aihub_web && pnpm dev

build:
	cd aihub_web && pnpm build

generate-sdk:
	cd aihub_web && pnpm generate-sdk