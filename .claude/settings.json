{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE_PATH=$(jq -r '.tool_input.file_path'); SCRIPT_DIR=$(dirname \"$0\"); \"$SCRIPT_DIR\"/run-pr-ready.sh \"$FILE_PATH\""
          }
        ]
      }
    ]
  }
}
