server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Long-cache hashed assets
    location ^~ /_nuxt/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Runtime config: generated per-deployment by envsubst at container start.
    # Never cached; served as the real file (not the SPA fallback).
    location = /config.js {
        add_header Cache-Control "no-store" always;
        default_type application/javascript;
        try_files $uri =404;
    }

    # SPA routing: every non-file path returns index.html
    location / {
        try_files $uri /index.html;
    }

    # Security headers (mirrors @swiss-ai-hub/web)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' ${CSP_SCRIPT_HASHES}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ${KEYCLOAK_ORIGIN} ${WS_ORIGIN} https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com; frame-src 'self' blob: ${WEBUI_ORIGIN} ${KEYCLOAK_ORIGIN}; form-action 'self' ${WEBUI_ORIGIN} ${KEYCLOAK_ORIGIN}; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;
}
