{
  "name": "@swiss-ai-hub/sysadmin-web",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "version": "0.297.6",
  "description": "Swiss AI Hub - System administration UI (Nuxt 3 layer over @swiss-ai-hub/web)",
  "main": "./nuxt.config.ts",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/bbvch-ai/aihub-core.git",
    "directory": "packages/sysadmin-web"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "app.vue",
    "nuxt.config.ts",
    "components/",
    "composables/",
    "i18n/",
    "layouts/",
    "middleware/",
    "pages/",
    "sdk/"
  ],
  "scripts": {
    "dev": "nuxi prepare && nuxi dev .app --port 3334 --dotenv ../../../.env",
    "dev:prepare": "nuxi prepare && nuxt prepare .app",
    "build": "nuxt generate .app",
    "preview": "nuxt preview .app",
    "lint": "(test -f .app/.nuxt/eslint.config.mjs || nuxi prepare .app) && eslint . --fix",
    "generate-sdk": "openapi-ts"
  },
  "dependencies": {
    "@swiss-ai-hub/web": "workspace:*"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.1",
    "@nuxt/eslint": "^1.15.2",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "nuxt": "3.21.0",
    "typescript": "^5.9.3",
    "vue": "3.5.17"
  }
}
