# Build stage: build the sysadmin-web SPA as part of the pnpm workspace.
# Build context is the monorepo root (set in docker-compose template and CI),
# so the workspace lockfile resolves deterministically and the @swiss-ai-hub/web
# layer is reachable at ./packages/web for `extends`.
FROM node:25-alpine AS builder

RUN rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg \
 && npm install -g --ignore-scripts corepack@0.34.7

WORKDIR /app

# Layer 1: workspace + member manifests only (cached unless deps change)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/web/package.json ./packages/web/package.json
COPY packages/sysadmin-web/package.json ./packages/sysadmin-web/package.json

RUN corepack enable && corepack install

# Install both web (the layer) and sysadmin-web. `...` pulls in workspace deps.
RUN pnpm install --frozen-lockfile --ignore-scripts --filter @swiss-ai-hub/sysadmin-web...

# Layer 2: package sources (invalidates only when sources change)
COPY packages/web ./packages/web
COPY packages/sysadmin-web ./packages/sysadmin-web

# web's tsconfig.json extends ./.app/.nuxt/tsconfig.json which is generated by
# `nuxi prepare`. The Nuxt Layer extension pulls in web's files for the
# sysadmin-web build, so vite needs to resolve web's tsconfig — prepare it first.
WORKDIR /app/packages/web
RUN pnpm exec nuxi prepare && pnpm exec nuxt prepare .app

WORKDIR /app/packages/sysadmin-web
RUN pnpm run build

# Runtime stage: nginx serves the static SPA
FROM nginx:stable-alpine

ARG USERNAME=user
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN addgroup -g "$USER_GID" "$USERNAME" \
  && adduser -D -H -u "$USER_UID" -G "$USERNAME" -s /sbin/nologin "$USERNAME"

RUN apk add --no-cache gettext

COPY --from=builder /app/packages/sysadmin-web/.app/.output/public /usr/share/nginx/html
COPY packages/sysadmin-web/nginx.conf /etc/nginx/conf.d/default.conf
COPY packages/sysadmin-web/config.template.js /usr/share/nginx/html/config.template.js

EXPOSE 80

CMD ["/bin/sh", "-c", "envsubst < /usr/share/nginx/html/config.template.js > /usr/share/nginx/html/config.js && nginx -g 'daemon off;'"]
