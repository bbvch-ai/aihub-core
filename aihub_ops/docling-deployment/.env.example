# ===================================================================
# Domain Configuration
# ===================================================================
DOMAIN=docling.ai-agents.ch
ACME_EMAIL=admin@ai-agents.ch

# ===================================================================
# PostgreSQL Database
# ===================================================================
# Generate password with: openssl rand -base64 24
POSTGRES_USER=litellm
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ===================================================================
# LiteLLM Configuration
# ===================================================================
# Master key for API authentication
# Use this key in your API requests: Authorization: Bearer <LITELLM_MASTER_KEY>
# Generate with: openssl rand -base64 32
LITELLM_MASTER_KEY=sk-REPLACE_WITH_SECURE_RANDOM_KEY

# UI credentials for LiteLLM dashboard
# Generate password with: openssl rand -base64 24
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ===================================================================
# HuggingFace Configuration
# ===================================================================
# Optional: Only needed if the model is gated
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ===================================================================
# Logging
# ===================================================================
LOG_LEVEL=INFO

# ===================================================================
# Docling Serve Configuration
# ===================================================================
DOCLING_SERVE_DOMAIN=serve.docling.ai-agents.ch

# IP Allowlist for Docling Serve (comma-separated CIDR notation)
# Example: 192.168.1.0/24,10.0.0.1/32
DOCLING_SERVE_ALLOWED_IPS=195.141.193.104/29,31.10.237.133/32
