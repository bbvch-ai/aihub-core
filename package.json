  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "vue": "3.5.17",
      "vue-router": "4.6.4"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@nuxt/cli>@nuxt/schema": "3.21.0",
        "vue3-apexcharts>apexcharts": "4.7.0",
        "c12>magicast": "0.5.2"
      }
    }
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
