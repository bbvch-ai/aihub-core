{
  "realm": "aihub",
  "enabled": true,
  "displayName": "Swiss AI-Hub",
  "displayNameHtml": "<strong>Swiss AI-Hub</strong>",
  "loginTheme": "aihub",
  "accountTheme": "keycloak.v2",
  "adminTheme": "keycloak.v2",
  "emailTheme": "keycloak",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "ssoSessionIdleTimeout": 432000,
  "ssoSessionMaxLifespan": 2592000,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,

  "editUsernameAllowed": false,
  "bruteForceProtected": true,

  "browserSecurityHeaders": {
    "contentSecurityPolicyReportOnly": "",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xFrameOptions": "",
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self' https://$(env:DOMAIN) https://*.$(env:DOMAIN); object-src 'none';"
  },

  "smtpServer": {},

  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}
