      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "rootUrl": "http://localhost:8888",
      "redirectUris": [
        "http://localhost:8888/*"
      ],
      "webOrigins": ["+"],
      "defaultClientScopes": [
        "openid",
