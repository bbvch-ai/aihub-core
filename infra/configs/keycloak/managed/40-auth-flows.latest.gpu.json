{
  "realm": "aihub",
  "browserFlow": "browser-aihub",
  "authenticationFlows": [
    {
      "alias": "Post Broker Login - AIHubAccess Check",
      "description": "Denies access to IdP users who do not have the AIHubAccess realm role",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "Deny Access Without AIHubAccess",
          "requirement": "CONDITIONAL",
          "priority": 0,
          "userSetupAllowed": false,
          "autheticatorFlow": true
        },
        {
          "authenticator": "allow-access-authenticator",
          "requirement": "REQUIRED",
          "priority": 1,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "flowAlias": "langfuse-gate-post-broker",
          "requirement": "CONDITIONAL",
          "priority": 2,
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "Deny Access Without AIHubAccess",
      "description": "Conditional sub-flow: if user does NOT have AIHubAccess role, deny access",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "aihub-access-role-condition",
          "requirement": "REQUIRED",
          "priority": 0,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorConfig": "aihub-access-deny-message",
          "requirement": "REQUIRED",
          "priority": 1,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    },
    {
      "alias": "browser-aihub",
      "description": "Browser flow with a deny gate for clients carrying the langfuse-sysadmin-gate scope. Replicates the built-in browser flow (cookie, IdP redirector, forms, conditional OTP); review on Keycloak major upgrades.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "browser-aihub-authenticate",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": true
        },
        {
          "flowAlias": "langfuse-gate-browser",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-aihub-authenticate",
      "description": "Authentication alternatives of the built-in browser flow, nested in a REQUIRED sub-flow so the CONDITIONAL gate does not disable them.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "flowAlias": "browser-aihub-forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-aihub-forms",
      "description": "Username, password, otp and other auth forms.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "flowAlias": "browser-aihub-conditional-2fa",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-aihub-conditional-2fa",
      "description": "Flow to determine if the OTP is required for the authentication.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    },
    {
      "alias": "langfuse-gate-browser",
      "description": "Conditional sub-flow: deny clients carrying the langfuse-sysadmin-gate scope unless the user has the AIHubSysAdmin role",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-client-scope",
          "authenticatorConfig": "langfuse-gate-browser-scope-condition",
          "requirement": "REQUIRED",
          "priority": 0,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "langfuse-gate-browser-role-condition",
          "requirement": "REQUIRED",
          "priority": 1,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorConfig": "langfuse-gate-browser-deny-message",
          "requirement": "REQUIRED",
          "priority": 2,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    },
    {
      "alias": "langfuse-gate-post-broker",
      "description": "Conditional sub-flow: deny clients carrying the langfuse-sysadmin-gate scope unless the user has the AIHubSysAdmin role",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-client-scope",
          "authenticatorConfig": "langfuse-gate-post-broker-scope-condition",
          "requirement": "REQUIRED",
          "priority": 0,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "langfuse-gate-post-broker-role-condition",
          "requirement": "REQUIRED",
          "priority": 1,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorConfig": "langfuse-gate-post-broker-deny-message",
          "requirement": "REQUIRED",
          "priority": 2,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],

  "authenticatorConfig": [
    {
      "alias": "aihub-access-role-condition",
      "config": {
        "condUserRole": "AIHubAccess",
        "negate": "true"
      }
    },
    {
      "alias": "aihub-access-deny-message",
      "config": {
        "error_message": "Access denied. You need the AIHubAccess role to use AI-Hub. Please contact your administrator."
      }
    },
    {
      "alias": "langfuse-gate-browser-scope-condition",
      "config": {
        "client_scope": "langfuse-sysadmin-gate",
        "negate": "false"
      }
    },
    {
      "alias": "langfuse-gate-browser-role-condition",
      "config": {
        "condUserRole": "AIHubSysAdmin",
        "negate": "true"
      }
    },
    {
      "alias": "langfuse-gate-browser-deny-message",
      "config": {
        "error_message": "Access denied. Langfuse is restricted to system administrators (AIHubSysAdmin). Please contact your administrator."
      }
    },
    {
      "alias": "langfuse-gate-post-broker-scope-condition",
      "config": {
        "client_scope": "langfuse-sysadmin-gate",
        "negate": "false"
      }
    },
    {
      "alias": "langfuse-gate-post-broker-role-condition",
      "config": {
        "condUserRole": "AIHubSysAdmin",
        "negate": "true"
      }
    },
    {
      "alias": "langfuse-gate-post-broker-deny-message",
      "config": {
        "error_message": "Access denied. Langfuse is restricted to system administrators (AIHubSysAdmin). Please contact your administrator."
      }
    }
  ]
}
