#!/bin/sh
# This file is auto-generated from a Jinja2 template.
# DO NOT EDIT THIS FILE DIRECTLY.
#
# To make changes, edit deployment/templates/configs/s3-ttl-init.sh.j2
set -e

SEAWEEDFS_MASTER=${SEAWEEDFS_MASTER:?SEAWEEDFS_MASTER must name the master as host:port}
SEAWEEDFS_FILER=${SEAWEEDFS_FILER:?SEAWEEDFS_FILER must name the filer as host:port}

# Bucket expiry is a filer TTL rule per path prefix, stamped on every object when it is written and enforced by
# dropping whole TTL volumes. It is deliberately not an S3 lifecycle configuration: since SeaweedFS 4.32 lifecycle
# rules only expire through an admin + worker pair we do not run, and a lifecycle PUT or DELETE on a bucket deletes
# the day-TTL rules SeaweedFS 4.01 created for it. Never apply a lifecycle configuration to these buckets. See ADR
# docs/arc42/decisions/2026_10_27_bucket_expiry_via_filer_ttl.md.
#
# - dagster: op-internal handoff data written by Dagster's default S3PickleIOManager. Asset finals route to domain
#   stores (MongoDB / Milvus / data lake buckets) via explicit io_manager_key, they do not live here.
# - parse-cache: MinerU and MarkItDown conversions keyed by document bytes (MineruParseCache, MarkItDownParseCache).
#   An expired entry is simply parsed again, so expiry bounds storage without losing anything.
# - sandbox-files/.deleted/: the sandbox mirror copies each user's sandbox home one way into sandbox-files and keeps a
#   file deleted or overwritten in the sandbox under .deleted/ for this grace period.
# - agent-files: uploads to agents, files they produced and the tables of record extractions. A table is a result to
#   download, not a record to keep.
#
# A rule is a path prefix, so it applies before its bucket exists. Without -collection: SeaweedFS rejects it for
# bucket paths.
{%- set TTL_RULES = [
    ("/buckets/dagster/", "1d"),
    ("/buckets/parse-cache/", "7d"),
    ("/buckets/sandbox-files/.deleted/", "7d"),
    ("/buckets/agent-files/", "7d"),
] %}

echo "Applying bucket TTL rules through ${SEAWEEDFS_MASTER}..."
weed shell -master="${SEAWEEDFS_MASTER}" -filer="${SEAWEEDFS_FILER}" <<EOF
lock
{%- for prefix, ttl in TTL_RULES %}
fs.configure -locationPrefix={{ prefix }} -ttl={{ ttl }} -apply
{%- endfor %}
unlock
EOF

# weed shell exits 0 when one of its commands fails, so check what the filer persisted.
FILER_CONF=$(wget -qO- "http://${SEAWEEDFS_FILER}/etc/seaweedfs/filer.conf" | tr -d ' \n')
{%- for prefix, ttl in TTL_RULES %}
if echo "${FILER_CONF}" | grep -q '"locationPrefix":"{{ prefix }}"[^}]*"ttl":"{{ ttl }}"'; then
  echo "  - {{ prefix }} ttl={{ ttl }}"
else
  echo "Missing TTL rule {{ prefix }} ttl={{ ttl }} in filer.conf" >&2
  exit 1
fi
{%- endfor %}

echo "Bucket TTL rules applied."
