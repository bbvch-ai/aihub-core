# ===================================================================
# OpenTelemetry Collector Configuration - Stage: {{ stage }}
# ===================================================================
# Generated from template. Do not edit directly.
# Collects traces, metrics, and logs for observability.
# ===================================================================

extensions:
  health_check:
    endpoint: 0.0.0.0:13133

  # Basic auth extension for Langfuse authentication
  basicauth/langfuse:
    client_auth:
      username: "${LANGFUSE_PUBLIC_KEY}"
      password: "${LANGFUSE_SECRET_KEY}"

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  batch:
{%- if stage in ['dev', 'local', 'build'] %}
    send_batch_size: 500
    timeout: 5s
{%- elif stage == "nightly" %}
    send_batch_size: 1000
    timeout: 10s
{%- elif stage == "latest" %}
    send_batch_size: 2000
    timeout: 15s
{%- endif %}

  # Stamp environment + host on ALL telemetry so every span/metric/log clearly
  # shows which environment (deployment.environment, e.g. staging/nightly/latest)
  # and which host it came from — alongside the service.name the app already
  # sets. Values are injected per-VM by the deployment (aihub-playbook env.j2);
  # the compose supplies a stage-name fallback so dev/local still render.
  resource/deployment:
    attributes:
      - key: deployment.environment
        value: "${OTEL_DEPLOYMENT_ENVIRONMENT}"
        action: upsert
      - key: host.name
        value: "${OTEL_HOST_NAME}"
        action: upsert

  filter/noise:
    error_mode: ignore
    traces:
      span:
        - 'attributes["http.route"] == "/health"'
        - 'attributes["http.route"] == "/metrics"'
        - 'attributes["db.system"] == "redis"'
        - 'attributes["db.system"] == "postgresql"'
        - 'attributes["db.system"] == "mongodb"'
        - 'resource.attributes["service.name"] == "litellm" and attributes["service"] == "postgres"'
        - 'resource.attributes["service.name"] == "litellm" and attributes["service"] == "auth"'

  # Filter spans for Langfuse: only keep LLM-related traces with OpenInference semantic conventions
  filter/langfuse:
    error_mode: ignore
    traces:
      span:
        - 'attributes["openinference.span.kind"] == nil'

  # Backstop (issue 1496): drop unbounded, high-cardinality HTTP server metrics
  # (side-effect of FastAPI/ASGI auto-instrumentation) before they reach the paid
  # backend. Dropping whole metrics needs no histogram re-aggregation. Catches any
  # emitter (e.g. open-webui) even if suppressed at the application source.
  filter/metrics_cardinality:
    error_mode: ignore
    metrics:
      metric:
        - 'name == "http.server.duration"'
        - 'name == "http.server.request.duration"'
        - 'name == "http.server.active_requests"'
        - 'name == "http.server.request.size"'
        - 'name == "http.server.response.size"'
        - 'name == "http.server.request.body.size"'
        - 'name == "http.server.response.body.size"'

exporters:
  # Generic cloud exporter with configurable headers
  # Controlled via environment variables:
  #   - OTEL_CLOUD_ENDPOINT: Target endpoint URL
  #   - OTEL_CLOUD_HEADERS: Authentication headers (e.g., "api-key=xxx")
  otlp/cloud:
    endpoint: "${OTEL_CLOUD_ENDPOINT}"
    headers: "${OTEL_CLOUD_HEADERS}"
    tls:
      insecure: false
    compression: gzip
    timeout: 60s
    retry_on_failure:
      enabled: true
      initial_interval: 5s
      max_interval: 60s

  # Langfuse OTLP exporter for AI observability
  # Langfuse accepts OTLP traces via HTTP with basic auth
  otlphttp/langfuse:
    endpoint: "http://langfuse-web:3000/api/public/otel"
    auth:
      authenticator: basicauth/langfuse
    tls:
      insecure: true
    timeout: 10s
    retry_on_failure:
      enabled: true
      initial_interval: 5s
      max_interval: 30s

  {%- if stage == 'dev' %}
  # Debug exporter for dev mode (logs/metrics to stdout)
  debug:
    verbosity: basic
    sampling_initial: 5
    sampling_thereafter: 200
  {%- endif %}

service:
  extensions: [ health_check, basicauth/langfuse ]
  pipelines:
    # Send OpenInference traces to the stack-local Langfuse instance
    traces/langfuse:
      receivers: [ otlp ]
      processors: [ filter/noise, filter/langfuse, resource/deployment, batch ]
      exporters: [ otlphttp/langfuse ]

    {%- if stage == 'dev' %}
    # Accept logs but use debug exporter (Langfuse doesn't support logs via OTEL)
    logs:
      receivers: [otlp]
      processors: [resource/deployment, batch]
      exporters: [debug]

    # Accept metrics but use debug exporter (Langfuse doesn't support metrics via OTEL)
    metrics:
      receivers: [otlp]
      processors: [filter/metrics_cardinality, resource/deployment, batch]
      exporters: [debug]
    {%- else %}
    # Send traces to cloud backend
    traces/cloud:
      receivers: [otlp]
      processors: [filter/noise, resource/deployment, batch]
      exporters: [otlp/cloud]

    # Send metrics to cloud backend
    metrics:
      receivers: [otlp]
      processors: [filter/metrics_cardinality, resource/deployment, batch]
      exporters: [otlp/cloud]

    # Send logs to cloud backend
    logs:
      receivers: [otlp]
      processors: [resource/deployment, batch]
      exporters: [otlp/cloud]
    {%- endif %}
