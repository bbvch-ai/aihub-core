# ===================================================================
# Dagster Workspace Configuration - Stage: {{ stage }}
# ===================================================================
# Generated from template. Do not edit directly.
# Defines code locations for Dagster to load pipelines from.
# ===================================================================

load_from:
{%- for pipeline in ['default_rag_pipeline', 'shared_rag_pipeline'] %}
{%- if image_tags[pipeline][stage] %}
  # Frozen legacy pipeline. Guarded on the same image tag as its compose service so the two cannot
  # drift: a code location for a container that is not deployed errors permanently in the Dagster UI.
  - grpc_server:
      host: {{ pipeline }}
      port: 4000
      location_name: {{ pipeline }}
{%- endif %}
{%- endfor %}
  - grpc_server:
      host: document_ingestion_pipeline
      port: 4000
      location_name: document_ingestion_pipeline
