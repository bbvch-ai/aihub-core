# ===================================================================
# Traefik Static Configuration
# ===================================================================
# This file contains the static configuration for Traefik reverse proxy.
# It defines entry points, providers, API settings, and certificate resolvers.
# ===================================================================

# aliasHeadersStrategy: Go treats X-Auth-User, X_Auth_User and X.Auth.User as three headers, while backends that map
# header names to variables read them as one, so a client could spoof a header a middleware sets. Dropping every header
# name with a character other than a letter, digit or dash closes that; Traefik 3.7.12+ warns for each entry point
# without it.
entryPoints:
  web:
    address: ":80"
    http:
      aliasHeadersStrategy: delete
  websecure:
    address: ":443"
    http:
      aliasHeadersStrategy: delete
{%- if stage in ['dev', 'local', 'build'] %}
      tls: true
{%- endif %}

providers:
  file:
    directory: /etc/traefik/dynamic
  docker:
    endpoint: "tcp://docker-socket-proxy:2375"
    watch: true
    exposedByDefault: false

api:
  dashboard: true
{%- if stage in ['dev', 'local', 'build'] %}
  insecure: true
{%- endif %}

{%- if stage not in ['dev', 'local', 'build'] %}
certificatesResolvers:
  letsencrypt:
    acme:
      storage: /etc/traefik/acme.json
      httpChallenge:
        entryPoint: web
{%- endif %}

